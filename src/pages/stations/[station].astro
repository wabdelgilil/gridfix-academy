---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StationProgress from '../../components/islands/progress/StationProgress.tsx';
import { getStation } from '../../data/curriculum';

export async function getStaticPaths() {
  const stations = await getCollection('stations');
  return stations.map((station) => ({
    params: { station: station.data.id },
    props: { station },
  }));
}

interface Props {
  station: CollectionEntry<'stations'>;
}

const { station } = Astro.props;
const { data } = station;
const { Content } = await render(station);
const allLessons = await getCollection('lessons');
const stationLessons = allLessons
  .filter((l) => l.data.station === data.id)
  .sort((a, b) => a.data.order - b.data.order);
const plan = getStation(data.id);
const liveIds = stationLessons.map((l) => l.data.id);
const plannedLessons = (plan?.lessons ?? []).filter((l) => l.status === 'planned');
---

<BaseLayout title={`${data.title} — منصة CFM`} description={data.description}>
  <div class="mx-auto max-w-4xl">
    <nav class="mb-6 text-sm text-ink-400" aria-label="Breadcrumb">
      <a href="/" class="transition hover:text-brand-700">الرئيسية</a>
      <span> ← </span>
      <span class="text-ink-600">{data.title}</span>
    </nav>

    <header class="card overflow-hidden">
      <div class="flex flex-wrap items-center gap-2 bg-gradient-to-l from-ink-900 to-brand-700 px-6 py-4">
        <span class="chip bg-white/20 text-white">{data.icon} {data.badge}</span>
        <span class="chip bg-white/20 text-white">المحطة {data.number}</span>
        {data.status === 'live' && <span class="chip bg-amber-400 text-amber-950">✅ بدأنا هنا</span>}
      </div>
      <div class="px-6 py-6">
        <h1 class="text-2xl font-bold leading-relaxed text-ink-900">{data.title}</h1>
        <p dir="ltr" lang="en" class="mt-1 text-sm text-ink-400">{data.titleEn}</p>
        <p class="mt-4 leading-relaxed text-ink-600"><Content /></p>
        {data.examWeight > 0 && (
          <div class="mt-4 flex items-center gap-2 text-sm text-ink-500">
            <span>وزن الركن في الامتحان:</span>
            <span class="chip bg-brand-100 text-brand-700" dir="ltr">{data.examWeight}%</span>
          </div>
        )}
      </div>
    </header>

    <div class="mt-6">
      <StationProgress stationId={data.id} lessonIds={liveIds} client:load />
    </div>

    <section class="mt-8">
      <h2 class="text-lg font-bold text-ink-900">دروس المحطة</h2>
      <div class="mt-4 grid gap-3">
        {stationLessons.map((lesson) => (
          <a
            href={`/lessons/${lesson.data.id}`}
            class="card flex items-center justify-between gap-4 p-4 transition hover:border-brand-500 hover:shadow-md"
          >
            <div class="flex items-center gap-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-sm font-bold text-brand-700" dir="ltr">
                {lesson.data.number}
              </span>
              <div>
                <h3 class="font-semibold text-ink-900">{lesson.data.title}</h3>
                <p class="mt-0.5 text-xs text-ink-400">
                  ⏱ {lesson.data.minutes} دقيقة
                  {lesson.data.hasTool && ' • 🛠 أداة تفاعلية'}
                  {lesson.data.quizId && ' • 💬 كويز'}
                </p>
              </div>
            </div>
            <span class="font-bold text-brand-600">←</span>
          </a>
        ))}

        {plannedLessons.map((p) => (
          <div class="flex items-center justify-between gap-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 opacity-80">
            <div class="flex items-center gap-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-200 text-sm font-bold text-ink-400" dir="ltr">
                {p.number}
              </span>
              <div>
                <h3 class="font-semibold text-ink-500">{p.title}</h3>
                <p class="mt-0.5 text-xs text-ink-400">📚 {p.minutes} دقيقة مقترحة {p.toolName ? `• 🛠 ${p.toolName}` : ''}</p>
              </div>
            </div>
            <span class="chip bg-amber-100 text-amber-800">قريباً</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>