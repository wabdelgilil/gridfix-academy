---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import MockExam from '../../components/islands/tools/cfm/MockExam.tsx';
import CmrpMockExam from '../../components/islands/tools/cmrp/CmrpMockExam.tsx';
import CamaMockExam from '../../components/islands/tools/cama/CamaMockExam.tsx';
import { getCourse, courses } from '../../data/courses';

export async function getStaticPaths() {
  return courses.map((courseEntry) => ({ params: { course: courseEntry.id } }));
}

interface Props {
  course: string;
}

const { course } = Astro.params;
const courseMeta = getCourse(course);
const isPlanned = !courseMeta || courseMeta.status !== 'live';
---

<BaseLayout title={`محاكي الامتحان — ${courseMeta?.code ?? ''}`} description="محاكي حقيقي للامتحان: أسئلة مواقف، مؤقت زمني، وتقرير تشخيصي حسب أركان المنهج." noindex={isPlanned}>
  <div class="mx-auto max-w-3xl">
    <Breadcrumb items={[{ label: courseMeta?.code ?? course, href: `/${course}` }, { label: 'محاكي الامتحان' }]} />
    <header class="mb-6">
      <span class="chip bg-brand-100 text-brand-700">🧪 تدريب فعلي</span>
      <h1 class="mt-3 text-2xl font-bold text-ink-900">📝 محاكي امتحان {courseMeta?.code ?? ''}</h1>
      <p class="mt-2 text-sm leading-relaxed text-ink-500">
        {course === 'cmrp'
          ? 'أسئلة مواقف حقيقية من ركائز SMRP الخمس مع مؤقت يحاكي إيقاع الامتحان الفعلي (80 ثانية للسؤال) وتقرير يبين أضعف ركيزة لديك بعد كل محاولة. اجمع 70% فأكثر لتعتبر جاهزاً.'
          : course === 'cama'
            ? 'أسئلة مواقف موزعة على مجلدات GFMAM الخمسة مع مؤقت يحاكي إيقاع الامتحان الفعلي (80 ثانية للسؤال، والامتحان الحقيقي 110 أسئلة في 150 دقيقة) وتقرير يبين أضعف مجلد لديك بعد كل محاولة. اجمع 70% فأكثر لتعتبر جاهزاً.'
            : 'أسئلة مواقف حقيقية من كل أركان المنهج مع مؤقت يحاكي إيقاع الامتحان الفعلي (90 ثانية للسؤال) وتقرير يبين أضعف ركن لديك بعد كل محاولة. اجمع 60% فأكثر لتعتبر جاهزاً، وكرر حتى تتجاوز 70%.'}
      </p>
    </header>

    {isPlanned ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <span class="text-4xl">🚧</span>
        <h2 class="mt-4 text-lg font-bold text-ink-900">محاكي الامتحان — قريباً</h2>
        <p class="mt-2 text-sm text-ink-400">{courseMeta?.description}</p>
        <a href="/" class="mt-4 inline-block font-semibold text-brand-700 hover:underline">← العودة لاختيار الكورس</a>
      </div>
    ) : course === 'cmrp' ? (
      <CmrpMockExam client:load />
    ) : course === 'cama' ? (
      <CamaMockExam client:load />
    ) : (
      <MockExam client:load />
    )}
  </div>
</BaseLayout>