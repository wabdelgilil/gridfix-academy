---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LangText from '../../components/ui/LangText.astro';
import ResumeLearning from '../../components/islands/ResumeLearning.tsx';
import { curriculum } from '../../data/curriculum';
import { getCourse, courses } from '../../data/courses';

export async function getStaticPaths() {
  return courses.map((courseEntry) => ({ params: { course: courseEntry.id } }));
}

interface Props {
  course: string;
}

const { course } = Astro.params;
const courseMeta = getCourse(course);
const isPlanned = !courseMeta || courseMeta.status === 'planned';
const courseImage = course === 'cmrp' ? '/og-cmrp.png' : course === 'cfm' ? '/og-cfm.png' : course === 'cama' ? '/og-cama.png' : undefined;

const lessons = !isPlanned ? await getCollection('lessons') : [];
const courseLessons = lessons.filter((l) => (l.data.course ?? 'cfm') === course);
const stationCards = !isPlanned
  ? curriculum.filter((s) => (s.courseId ?? 'cfm') === course && s.status === 'live').sort((a, b) => a.number - b.number)
  : [];
const totalMinutes = lessons.filter((l) => (l.data.course ?? 'cfm') === course).reduce((sum, l) => sum + l.data.minutes, 0);
const liveStations = !isPlanned ? stationCards.length : 0;
const station0 = !isPlanned ? stationCards.find((s) => s.number === 0) : undefined;

const courseJsonLd = !isPlanned && courseMeta
  ? {
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: `${courseMeta.title} (${courseMeta.code})`,
      description: courseMeta.description,
      inLanguage: 'ar',
      isAccessibleForFree: true,
      provider: {
        '@type': 'Organization',
        name: 'GridFix Academy',
        sameAs: 'https://gridfix.net',
      },
      url: new URL(`/${course}`, Astro.site ?? 'https://academy.gridfix.net').toString(),
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'online',
        courseWorkload: `PT${Math.round(totalMinutes / 60)}H`,
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
    }
  : null;
---

<BaseLayout title={`${courseMeta ? `${courseMeta.title} — ${courseMeta.titleEn}` : 'الكورس'} | صالة GridFix`} titleEn={`${courseMeta?.titleEn ?? 'Course'} | GridFix Academy`} description={courseMeta?.description ?? 'منصة GridFix التعليمية'} descriptionEn={courseMeta?.descriptionEn ?? 'GridFix Academy educational platform'} noindex={isPlanned} image={courseImage}>
  {courseJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} />}
  <Breadcrumb items={[{ label: courseMeta?.code ?? course, labelEn: courseMeta?.code ?? course }]} />
  {isPlanned ? (
    <div class="mx-auto max-w-2xl text-center animate-fade-in">
      <span class="text-6xl animate-float">{courseMeta?.icon ?? '⏳'}</span>
      <h1 class="mt-6 text-3xl font-bold text-ink-900">
        <LangText lang="ar">{courseMeta?.code} — قريباً</LangText>
        <LangText lang="en">{courseMeta?.code} — Coming soon</LangText>
      </h1>
      <p class="mt-3 leading-relaxed text-ink-600">
        <LangText lang="ar">{courseMeta?.description}</LangText>
        <LangText lang="en">{courseMeta?.descriptionEn}</LangText>
      </p>
      <span class="chip mt-6 bg-amber-100 text-amber-800">
        <LangText lang="ar">🚧 قيد البناء — سيُطلق قريباً</LangText>
        <LangText lang="en">🚧 Under construction — coming soon</LangText>
      </span>
      <p class="mt-4 text-sm text-ink-400">
        <a href="/" class="font-semibold text-brand-700 hover:underline">
          <LangText lang="ar">← العودة لاختيار الكورس</LangText>
          <LangText lang="en">← Back to course selection</LangText>
        </a>
      </p>
    </div>
  ) : (
    <>
      <section class="relative overflow-hidden rounded-3xl bg-gradient-to-l from-ink-900 via-brand-800 to-brand-600 px-6 py-14 text-white sm:px-12 animate-fade-in">
        <div class="absolute inset-0 overflow-hidden">
          <div class="absolute -top-24 -start-24 h-64 w-64 rounded-full bg-brand-400/10 blur-3xl"></div>
          <div class="absolute -bottom-24 -end-24 h-64 w-64 rounded-full bg-amber-400/10 blur-3xl"></div>
        </div>
        <div class="relative z-10 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="chip bg-amber-400 text-amber-950">
              <LangText lang="ar">🎯 {liveStations} محطات متاحة الآن</LangText>
              <LangText lang="en">🎯 {liveStations} stations available now</LangText>
            </span>
            <span class="chip bg-white/15 text-white">
              <LangText lang="ar">💚 منصة مجانية بالكامل</LangText>
              <LangText lang="en">💚 100% free platform</LangText>
            </span>
          </div>
          <h1 class="mt-4 text-3xl font-bold leading-relaxed sm:text-4xl">
            <LangText lang="ar">{courseMeta!.title} بالطريقة العملية</LangText>
            <LangText lang="en">{courseMeta!.titleEn} — the practical way</LangText>
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-teal-50">
            <LangText lang="ar">
              {courseMeta!.description} مع شرح عربي ومصطلحات إنجليزية وتمارين تفاعلية —{' '}
              <strong>مجاناً بالكامل</strong>، مقدمة من منصة{' '}
              <a href="https://gridfix.net" target="_blank" rel="noopener" class="font-bold text-amber-300 underline underline-offset-4 hover:text-amber-200">
                GridFix Academy
              </a>.
            </LangText>
            <LangText lang="en">
              {courseMeta!.descriptionEn} With Arabic explanations, English terminology, and interactive exercises —{' '}
              <strong>completely free</strong>, offered by{' '}
              <a href="https://gridfix.net" target="_blank" rel="noopener" class="font-bold text-amber-300 underline underline-offset-4 hover:text-amber-200">
                GridFix Academy
              </a>.
            </LangText>
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {(station0 ?? stationCards[0]) && (
              <a href={`/${course}/stations/${(station0 ?? stationCards[0])!.id}`} class="btn-primary bg-amber-400 text-amber-950 hover:bg-amber-300">
                <LangText lang="ar">{station0 ? 'ابدأ التعلم من المحطة 0 ←' : 'ابدأ التعلم من المحطة 1 ←'}</LangText>
                <LangText lang="en">{station0 ? 'Start learning at Station 0 →' : 'Start learning at Station 1 →'}</LangText>
              </a>
            )}
            <a href={`/${course}/map`} class="btn-outline border-white/30 text-white hover:bg-white/10">
              <LangText lang="ar">خريطة المنهج</LangText>
              <LangText lang="en">Curriculum map</LangText>
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-6 text-sm text-teal-50">
            <span class="flex items-center gap-2">
              <span class="font-bold text-amber-300">{courseLessons.length}</span>
              <LangText lang="ar"> دروس متاحة</LangText>
              <LangText lang="en"> lessons available</LangText>
            </span>
            <span class="flex items-center gap-2">
              <span class="font-bold text-amber-300">{totalMinutes}</span>
              <LangText lang="ar"> دقيقة إجمالاً</LangText>
              <LangText lang="en"> minutes total</LangText>
            </span>
            <span class="flex items-center gap-2">
              <span class="font-bold text-amber-300">{liveStations}</span>
              <LangText lang="ar"> محطة</LangText>
              <LangText lang="en"> stations</LangText>
            </span>
          </div>
        </div>
      </section>

      <!-- استئناف التعلم -->
      <div class="mt-8">
        <ResumeLearning course={course} client:load />
      </div>

      <!-- بنية الدرس -->
      <section class="mt-12">
        <h2 class="text-xl font-bold text-ink-900">
          <LangText lang="ar">بنية موحّدة لكل درس</LangText>
          <LangText lang="en">A unified structure for every lesson</LangText>
        </h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
          {[
            { icon: '🎯', ar: 'أهداف التعلم', en: 'Learning objectives' },
            { icon: '📖', ar: 'شرح نظري', en: 'Theory' },
            { icon: '⚠️', ar: 'تصحيح المفاهيم', en: 'Myth-busting' },
            { icon: '📚', ar: 'قاموس المصطلحات', en: 'Glossary' },
            { icon: '🛠', ar: 'أداة تفاعلية', en: 'Interactive tool' },
            { icon: '💬', ar: 'كويز سيناريو', en: 'Scenario quiz' },
            { icon: '📎', ar: 'مصادر موثوقة', en: 'Trusted sources' },
          ].map((item, i) => (
            <div class={`flex flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-5 text-center text-sm font-medium text-ink-700 shadow-sm transition-all duration-300 hover:border-brand-300 hover:shadow-md animate-fade-in stagger-${i + 1}`}>
              <span class="mb-2 block text-xl transition-transform duration-300 hover:scale-125">{item.icon}</span>
              <span>
                <LangText lang="ar">{item.ar}</LangText>
                <LangText lang="en">{item.en}</LangText>
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- خريطة المحطات -->
      <section class="mt-12">
        <h2 class="text-xl font-bold text-ink-900">
          <LangText lang="ar">خريطة المحطات</LangText>
          <LangText lang="en">Station map</LangText>
        </h2>
        <p class="mt-1 text-sm text-ink-400">
          <LangText lang="ar">المسار الكامل من التأسيس حتى محاكي الامتحان.</LangText>
          <LangText lang="en">The full path from the foundations to the exam simulator.</LangText>
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {stationCards.map((s, i) => {
            const live = s.lessons.filter((l) => l.status === 'live').length;
            return (
              <a
                href={`/${course}/stations/${s.id}`}
                class={`card p-5 card-hover animate-fade-in stagger-${(i % 6) + 1}`}
              >
                <div class="flex items-start justify-between">
                  <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-2xl transition-transform duration-300 hover:scale-110">
                    {s.icon}
                  </span>
                  <span class="chip bg-brand-100 text-brand-700">
                    <LangText lang="ar">✅ متاح</LangText>
                    <LangText lang="en">✅ Live</LangText>
                  </span>
                </div>
                <h3 class="mt-3 font-bold text-ink-900">
                  <LangText lang="ar">{s.title}</LangText>
                  <LangText lang="en">{s.titleEn}</LangText>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  <LangText lang="ar">{s.description}</LangText>
                  <LangText lang="en">{s.descriptionEn}</LangText>
                </p>
                <div class="mt-3 flex items-center justify-between text-sm">
                  <span class="chip bg-slate-100 text-ink-600">
                    📚 {live}
                    <LangText lang="ar"> دروس متاحة</LangText>
                    <LangText lang="en"> lessons</LangText>
                  </span>
                  <span class="font-bold text-brand-600 transition-transform duration-300 group-hover:translate-x-[-4px]">←</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    </>
  )}
</BaseLayout>
