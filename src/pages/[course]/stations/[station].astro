---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import LangSection from '../../../components/ui/LangSection.astro';
import LangText from '../../../components/ui/LangText.astro';
import StationProgress from '../../../components/islands/progress/StationProgress.tsx';
import { getStation } from '../../../data/curriculum';
import { getLiveCourses } from '../../../data/courses';

export async function getStaticPaths() {
  const live = getLiveCourses().map((c) => c.id);
  const stations = await getCollection('stations');
  return stations
    .filter((s) => live.includes(s.data.course))
    .map((station) => ({
      params: { course: station.data.course, station: station.data.id },
      props: { station },
    }));
}

interface Props {
  station: CollectionEntry<'stations'>;
}

const { station } = Astro.props;
const { data } = station;
const { Content } = await render(station);
const allLessons = await getCollection('lessons');
const stationLessons = allLessons
  .filter((l) => l.data.station === data.id && l.data.course === data.course)
  .sort((a, b) => a.data.order - b.data.order);
const plan = getStation(data.id);
const liveIds = stationLessons.map((l) => l.data.id);
const plannedLessons = (plan?.lessons ?? []).filter((l) => l.status === 'planned');
const courseMeta = getLiveCourses().find((c) => c.id === data.course);
---

<BaseLayout title={`${data.title} — ${courseMeta?.code ?? ''}`} titleEn={`${data.titleEn} — ${courseMeta?.code ?? ''}`} description={`${data.titleEn} — ${data.descriptionEn}`}>
  <div class="mx-auto max-w-4xl">
    <Breadcrumb items={[{ label: courseMeta?.code ?? data.course, href: `/${data.course}` }, { label: data.title, labelEn: data.titleEn }]} />

    <header class="card overflow-hidden animate-fade-in">
      <div class="flex flex-wrap items-center gap-2 bg-gradient-to-l from-ink-900 to-brand-700 px-6 py-4">
        <span class="chip bg-white/20 text-white">
          <LangText lang="ar">{data.icon} {data.badge}</LangText>
          <LangText lang="en">{data.icon} {data.badgeEn}</LangText>
        </span>
        <span class="chip bg-white/20 text-white">
          <LangText lang="ar">المحطة {data.number}</LangText>
          <LangText lang="en">Station {data.number}</LangText>
        </span>
        {data.status === 'live' && (
          <span class="chip bg-amber-400 text-amber-950">
            <LangText lang="ar">✅ بدأنا هنا</LangText>
            <LangText lang="en">✅ Live</LangText>
          </span>
        )}
      </div>
      <div class="px-6 py-6">
        <h1 class="text-2xl font-bold leading-relaxed text-ink-900">
          <LangText lang="ar">{data.title}</LangText>
          <LangText lang="en">{data.titleEn}</LangText>
        </h1>
        <div class="mt-4 leading-relaxed text-ink-600">
          <LangSection lang="ar"><Content /></LangSection>
          <LangSection lang="en">{data.descriptionEn}</LangSection>
        </div>
        {data.examWeight > 0 && (
          <div class="mt-4 flex items-center gap-2 text-sm text-ink-500">
            {data.domain && (
              <span>
                <LangText lang="ar">المجال</LangText>
                <LangText lang="en">Domain</LangText>
                <span class="chip bg-teal-100 text-teal-700" dir="ltr">{data.domain}</span>
              </span>
            )}
            <span>
              <LangText lang="ar">وزن الركن في الامتحان:</LangText>
              <LangText lang="en">Exam weight:</LangText>
            </span>
            <span class="chip bg-brand-100 text-brand-700" dir="ltr">{data.examWeight}%</span>
          </div>
        )}
      </div>
    </header>

    <div class="mt-6 animate-fade-in stagger-1">
      <StationProgress course={data.course} stationId={data.id} lessonIds={liveIds} client:load />
    </div>

    <section class="mt-8">
      <h2 class="text-lg font-bold text-ink-900">
        <LangText lang="ar">دروس المحطة</LangText>
        <LangText lang="en">Station lessons</LangText>
      </h2>
      <div class="mt-4 grid gap-3">
        {stationLessons.map((lesson, i) => (
          <a
            href={`/${data.course}/lessons/${lesson.data.id}`}
            class={`card flex items-center justify-between gap-4 p-4 card-hover animate-fade-in stagger-${(i % 4) + 1}`}
          >
            <div class="flex items-center gap-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-sm font-bold text-brand-700 transition-all duration-300 group-hover:bg-brand-100 group-hover:scale-110" dir="ltr">
                {lesson.data.number}
              </span>
              <div>
                <h3 class="font-semibold text-ink-900">
                  <LangText lang="ar">{lesson.data.title}</LangText>
                  <LangText lang="en">{lesson.data.titleEn}</LangText>
                </h3>
                <p class="mt-0.5 flex flex-wrap items-center gap-1 text-xs text-ink-400">
                  <span>
                    ⏱ {lesson.data.minutes}
                    <LangText lang="ar"> دقيقة</LangText>
                    <LangText lang="en"> min</LangText>
                  </span>
                  {lesson.data.hasTool && (
                    <span class="chip bg-brand-50 text-brand-700 text-[10px] py-0">
                      <LangText lang="ar">🛠 أداة تفاعلية</LangText>
                      <LangText lang="en">🛠 Interactive tool</LangText>
                    </span>
                  )}
                  {lesson.data.quizId && (
                    <span class="chip bg-amber-50 text-amber-700 text-[10px] py-0">
                      <LangText lang="ar">💬 كويز</LangText>
                      <LangText lang="en">💬 Quiz</LangText>
                    </span>
                  )}
                </p>
              </div>
            </div>
            <span class="font-bold text-brand-600 transition-transform duration-300 group-hover:translate-x-[-4px]">←</span>
          </a>
        ))}

        {plannedLessons.map((p, i) => (
          <div class={`flex items-center justify-between gap-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 opacity-80 animate-fade-in stagger-${(i % 4) + 1}`}>
            <div class="flex items-center gap-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-200 text-sm font-bold text-ink-400" dir="ltr">
                {p.number}
              </span>
              <div>
                <h3 class="font-semibold text-ink-500">
                  <LangText lang="ar">{p.title}</LangText>
                  <LangText lang="en">{p.titleEn}</LangText>
                </h3>
                <p class="mt-0.5 text-xs text-ink-400">
                  <LangText lang="ar">📚 {p.minutes} دقيقة مقترحة {p.toolName ? `• 🛠 ${p.toolName}` : ''}</LangText>
                  <LangText lang="en">📚 {p.minutes} planned minutes {p.toolName ? `• 🛠 ${p.toolNameEn ?? p.toolName}` : ''}</LangText>
                </p>
              </div>
            </div>
            <span class="chip bg-amber-100 text-amber-800">
              <LangText lang="ar">قريباً</LangText>
              <LangText lang="en">Coming soon</LangText>
            </span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
