---
import BaseLayout from '../layouts/BaseLayout.astro';
import LangText from '../components/ui/LangText.astro';
import ResumeLearningWidget from '../components/islands/progress/ResumeLearningWidget.tsx';
import { courses } from '../data/courses';
import { curriculum } from '../data/curriculum';

const liveCourses = courses.filter((c) => c.status === 'live');
const plannedCourses = courses.filter((c) => c.status === 'planned');

const perCourse = liveCourses.map((c) => {
  const stations = curriculum.filter((s) => (s.courseId ?? 'cfm') === c.id).length;
  const lessons = curriculum
    .filter((s) => (s.courseId ?? 'cfm') === c.id)
    .reduce((acc, s) => acc + s.lessons.filter((l) => l.status === 'live').length, 0);
  return { course: c, stations, lessons };
});

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'GridFix Academy',
  url: 'https://academy.gridfix.net',
  description: 'منصة تعليمية عربية مجانية لإدارة المنشآت والصيانة وإدارة الأصول.',
  inLanguage: 'ar',
  parentOrganization: { '@type': 'Organization', name: 'GridFix', url: 'https://gridfix.net' },
};
---

<BaseLayout title="GridFix Academy — تعلم CFM وCMRP وCAMA مجاناً بالعربية" titleEn="GridFix Academy — learn CFM, CMRP &amp; CAMA in Arabic for free" description="منصة تعليمية عربية مجانية مقدمة من GridFix: كورسات منظمة لشهادات CFM وCMRP وCAMA بالعربية مع المصطلحات الإنجليزية وأدوات تفاعلية." descriptionEn="A free Arabic learning platform by GridFix: structured courses for the CFM, CMRP and CAMA credentials in Arabic, with English terminology and interactive tools.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-l from-ink-900 via-brand-800 to-brand-600 px-6 py-16 text-center text-white sm:px-12">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 -start-24 h-64 w-64 rounded-full bg-brand-400/10 blur-3xl"></div>
      <div class="absolute -bottom-24 -end-24 h-64 w-64 rounded-full bg-amber-400/10 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-2xl">
      <div class="mb-6 flex justify-center">
        <div class="group relative">
          <!-- هالة ضوئية تمنح اللوجو فخامة وتبرزه فوق الخلفية الزرقاء -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-amber-400 via-white/40 to-cyan-300 opacity-70 blur-md transition-all duration-300 group-hover:opacity-100 group-hover:blur-lg"></div>
          <!-- قاعدة بيضاء ناصعة تُظهر ألوان وتفاصيل اللوجو بوضوح وتباين كامل -->
          <div class="relative flex h-24 w-24 sm:h-28 sm:w-28 items-center justify-center rounded-3xl bg-white p-3.5 shadow-2xl ring-4 ring-white/50 transition-transform duration-300 group-hover:scale-105">
            <img src="/logo-academic.svg" alt="GridFix Academy" width="112" height="112" class="h-full w-full object-contain" />
          </div>
        </div>
      </div>
      <span class="chip bg-amber-400 text-amber-950">
        <LangText lang="ar">منصة تعليمية مجانية بالكامل</LangText>
        <LangText lang="en">100% free learning platform</LangText>
      </span>
      <h1 class="mt-5 text-3xl font-bold leading-relaxed sm:text-4xl lg:text-5xl">
        <LangText lang="ar">تعلّم إدارة المنشآت والصيانة <span class="text-amber-300">باحتراف</span></LangText>
        <LangText lang="en">Master Facility &amp; Asset Management <span class="text-amber-300">Professionally</span></LangText>
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-blue-50">
        <LangText lang="ar">
          أكاديمية <strong class="text-amber-300">GridFix Academy</strong> تقدّم كورسات عربية
          عملية لأشهر شهادات المجال — مع شرح بالمصطلحات الإنجليزية، أدوات تفاعلية، وكويزات مواقف. اختر مسارك وابدأ الآن.
        </LangText>
        <LangText lang="en">
          <strong class="text-amber-300">GridFix Academy</strong> offers practical courses in Arabic
          for the field's leading certifications — with English terminology, interactive tools, and scenario quizzes. Pick your path and start now.
        </LangText>
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm text-blue-50">
        <span class="flex items-center gap-2">
          <span class="font-bold text-amber-300">{liveCourses.length}</span>
          <LangText lang="ar">كورسات تخصصية</LangText>
          <LangText lang="en">specialized courses</LangText>
        </span>
        <span class="flex items-center gap-2">
          <span class="font-bold text-amber-300">{perCourse.reduce((a, c) => a + c.stations, 0)}</span>
          <LangText lang="ar">محطة</LangText>
          <LangText lang="en">stations</LangText>
        </span>
        <span class="flex items-center gap-2">
          <span class="font-bold text-amber-300">{perCourse.reduce((a, c) => a + c.lessons, 0)}</span>
          <LangText lang="ar">درساً</LangText>
          <LangText lang="en">lessons</LangText>
        </span>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        {liveCourses[0] && (
          <a href={`/${liveCourses[0].id}`} class="rounded-xl bg-amber-400 px-6 py-3 font-bold text-amber-950 transition hover:bg-amber-300">
            <LangText lang="ar">ابدأ التعلم مجاناً ←</LangText>
            <LangText lang="en">Start learning for free →</LangText>
          </a>
        )}
      </div>
    </div>
  </section>

  <div class="mt-8 mx-auto max-w-2xl">
    <ResumeLearningWidget client:load />
  </div>

  <section id="courses" class="mt-12">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-xl font-bold text-ink-900">
          <LangText lang="ar">اختر كورسك</LangText>
          <LangText lang="en">Choose your course</LangText>
        </h2>
        <p class="mt-1 text-sm text-ink-400">
          <LangText lang="ar">كل كورس مسار مستقل: محطات، أدوات، وقاموس خاص به.</LangText>
          <LangText lang="en">Each course is an independent path: stations, tools, and its own glossary.</LangText>
        </p>
      </div>
    </div>

    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {liveCourses.map((c) => {
        const stats = perCourse.find((p) => p.course.id === c.id);
        return (
          <a href={`/${c.id}`} class="card group overflow-hidden transition hover:border-brand-500 hover:shadow-md">
            <div class="flex items-start justify-between bg-gradient-to-l from-ink-900 to-brand-700 px-6 py-5 text-white">
              <div class="flex items-center gap-3">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 text-2xl transition-transform duration-300 group-hover:scale-110">{c.icon}</span>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-lg font-bold">
                      <LangText lang="ar">{c.title}</LangText>
                      <LangText lang="en">{c.titleEn}</LangText>
                    </h3>
                    <span class="chip bg-amber-400 text-amber-950" dir="ltr">{c.code}</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="px-6 py-5">
              <p class="text-sm leading-relaxed text-ink-600">
                <LangText lang="ar">{c.description}</LangText>
                <LangText lang="en">{c.descriptionEn}</LangText>
              </p>
              <div class="mt-4 flex items-center justify-between text-sm">
                <span class="flex flex-wrap gap-2">
                  <span class="chip bg-slate-100 text-ink-600">
                    🗺 {stats?.stations}
                    <LangText lang="ar"> محطات</LangText>
                    <LangText lang="en"> stations</LangText>
                  </span>
                  <span class="chip bg-slate-100 text-ink-600">
                    📚 {stats?.lessons}
                    <LangText lang="ar"> دروس</LangText>
                    <LangText lang="en"> lessons</LangText>
                  </span>
                </span>
                <span class="font-bold text-brand-600 transition group-hover:-translate-x-1">
                  <LangText lang="ar">← ابدأ التعلم</LangText>
                  <LangText lang="en">Start learning →</LangText>
                </span>
              </div>
            </div>
          </a>
        );
      })}

      {plannedCourses.map((c) => (
        <div class="card overflow-hidden opacity-80">
          <div class="flex items-start justify-between bg-gradient-to-l from-slate-500 to-slate-700 px-6 py-5 text-white">
            <div class="flex items-center gap-3">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 text-2xl">{c.icon}</span>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-bold">
                    <LangText lang="ar">{c.title}</LangText>
                    <LangText lang="en">{c.titleEn}</LangText>
                  </h3>
                  <span class="chip bg-slate-100 text-ink-700" dir="ltr">{c.code}</span>
                </div>
              </div>
            </div>
            <span class="chip bg-amber-400/20 text-amber-200">
              <LangText lang="ar">قريباً</LangText>
              <LangText lang="en">Coming soon</LangText>
            </span>
          </div>
          <div class="px-6 py-5">
            <p class="text-sm leading-relaxed text-ink-600">
              <LangText lang="ar">{c.description}</LangText>
              <LangText lang="en">{c.descriptionEn}</LangText>
            </p>
            <div class="mt-4">
              <span class="chip bg-slate-100 text-ink-600">
                <LangText lang="ar">سيُطلق قريباً — اشترك ليصلك التنبيه</LangText>
                <LangText lang="en">Coming soon — subscribe for the launch alert</LangText>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-12 grid gap-4 sm:grid-cols-3">
    {[
      { icon: '🎯', titleAr: 'مسارات منظمة بالمحطات', titleEn: 'Structured station paths', descAr: 'محطات متسلسلة من التأسيس للتمكين مع أوزان الامتحان', descEn: 'Sequential stations from foundation to mastery with exam weights' },
      { icon: '🛠', titleAr: 'أدوات تفاعلية تطبيقية', titleEn: 'Hands-on interactive tools', descAr: 'أكثر من 40 أداة عملية لتطبيق المفاهيم فعلياً', descEn: 'More than 40 practical tools to truly apply the concepts' },
      { icon: '📝', titleAr: 'كويزات محاكية للامتحان', titleEn: 'Exam-style quizzes', descAr: 'سيناريوهات حقيقية مع تقييم فوري وتشخيص', descEn: 'Real scenarios with instant scoring and diagnosis' },
    ].map((item) => (
      <div class="card flex flex-col items-center gap-3 p-6 text-center">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-3xl transition-transform duration-300 hover:scale-110">
          {item.icon}
        </span>
        <h3 class="font-bold text-ink-900">
          <LangText lang="ar">{item.titleAr}</LangText>
          <LangText lang="en">{item.titleEn}</LangText>
        </h3>
        <p class="text-sm leading-relaxed text-ink-500">
          <LangText lang="ar">{item.descAr}</LangText>
          <LangText lang="en">{item.descEn}</LangText>
        </p>
      </div>
    ))}
  </section>

  <!-- قسم مبادرة المسؤولية المعرفية لـ GridFix -->
  <section class="mt-16 overflow-hidden rounded-3xl border border-blue-100 bg-gradient-to-br from-white via-blue-50/40 to-slate-50 p-8 shadow-xs transition-all duration-300 hover:border-blue-200 sm:p-12 dark:border-slate-800 dark:from-slate-900 dark:via-slate-900/80 dark:to-blue-950/20">
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-100/70 px-4 py-1.5 text-xs font-bold text-brand-700 dark:border-blue-900/80 dark:bg-blue-950/70 dark:text-blue-300">
          <span class="flex h-2 w-2 rounded-full bg-brand-500 animate-pulse"></span>
          <LangText lang="ar">مبادرة المسؤولية المعرفية والمجتمعية • برعاية ودعم GridFix</LangText>
          <LangText lang="en">Knowledge &amp; Social Responsibility Initiative • Powered by GridFix</LangText>
        </div>

        <h2 class="mt-5 text-2xl font-black tracking-tight text-ink-900 sm:text-3xl lg:text-4xl dark:text-white">
          <LangText lang="ar">
            من الميدان إلى الاعتماد المهني — <span class="text-brand-600 dark:text-brand-400">بخبرة مهندسي GridFix</span>
          </LangText>
          <LangText lang="en">
            From the Field to Global Certification — <span class="text-brand-600 dark:text-brand-400">Backed by GridFix Engineering</span>
          </LangText>
        </h2>

        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600 dark:text-slate-300">
          <LangText lang="ar">
            تُقدّم هذه المنصة التعليمية مجاناً بالكامل من شركة <strong class="text-ink-900 dark:text-white">GridFix</strong> المتخصصة في أنظمة إدارة الصيانة والمرافق الذكية (<span dir="ltr">CMMS</span>) للمصانع والمستشفيات والمنشآت الكبرى. نؤمن بأن تمكين الكفاءات الهندسية العربية هو حجر الأساس لاستدامة الأصول ورفع الموثوقية التشغيلية.
          </LangText>
          <LangText lang="en">
            This learning platform is offered completely free by <strong class="text-ink-900 dark:text-white">GridFix</strong>, specialists in smart Computerized Maintenance Management Systems (CMMS) for industrial plants, healthcare, and enterprise facilities. We believe empowering engineering talent is the foundation of asset reliability.
          </LangText>
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 shadow-2xs backdrop-blur-xs transition-transform hover:-translate-y-1 dark:border-slate-800 dark:bg-slate-800/90">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl font-bold text-brand-600 dark:bg-blue-950 dark:text-blue-400">
            ⚡
          </div>
          <h3 class="mt-3 text-sm font-bold text-ink-900 dark:text-white">
            <LangText lang="ar">نظام GridFix الميداني</LangText>
            <LangText lang="en">GridFix Field CMMS</LangText>
          </h3>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-500 dark:text-slate-400">
            <LangText lang="ar">إدارة أوامر العمل، الجداول الوقائية، والمزامنة الكاملة دون اتصال بالإنترنت (Offline-First).</LangText>
            <LangText lang="en">Work orders, preventive schedules, and full offline-first synchronization.</LangText>
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 shadow-2xs backdrop-blur-xs transition-transform hover:-translate-y-1 dark:border-slate-800 dark:bg-slate-800/90">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl font-bold text-amber-600 dark:bg-amber-950/60 dark:text-amber-400">
            🎓
          </div>
          <h3 class="mt-3 text-sm font-bold text-ink-900 dark:text-white">
            <LangText lang="ar">تأهيل للاعتمادات العالمية</LangText>
            <LangText lang="en">Global Credentials Prep</LangText>
          </h3>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-500 dark:text-slate-400">
            <LangText lang="ar">تحضير حقيقي لشهادات CFM و CMRP و CAMA وفق المعايير الرسمية لأكبر الهيئات الدولية.</LangText>
            <LangText lang="en">Rigorous preparation for CFM, CMRP, and CAMA credentials based on global frameworks.</LangText>
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 shadow-2xs backdrop-blur-xs transition-transform hover:-translate-y-1 dark:border-slate-800 dark:bg-slate-800/90">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl font-bold text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400">
            💚
          </div>
          <h3 class="mt-3 text-sm font-bold text-ink-900 dark:text-white">
            <LangText lang="ar">محتوى مفتوح ومجاني للجميع</LangText>
            <LangText lang="en">Open Access Forever</LangText>
          </h3>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-500 dark:text-slate-400">
            <LangText lang="ar">كافة الدروس، الكويزات، والأدوات التفاعلية مجانية بالكامل دون رسوم أو اشتراكات كخدمة مجتمعية.</LangText>
            <LangText lang="en">All lessons, quizzes, and calculators are accessible without paywalls or subscriptions.</LangText>
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 pt-4 border-t border-slate-200/70 dark:border-slate-800">
        <a
          href="https://gridfix.net"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-xs transition hover:bg-brand-700 hover:shadow-md"
        >
          <span>⚡</span>
          <LangText lang="ar">استكشف نظام GridFix CMMS للمنشآت والمصانع</LangText>
          <LangText lang="en">Explore GridFix CMMS for Facilities &amp; Plants</LangText>
          <span class="text-xs">↗</span>
        </a>
        <a
          href="https://gridfix.net/demo"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-ink-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          <LangText lang="ar">تجربة النسخة الحية (Live Demo)</LangText>
          <LangText lang="en">Try Live Demo (Interactive)</LangText>
          <span class="text-xs text-ink-400">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mt-12 rounded-3xl bg-gradient-to-l from-brand-50 to-brand-100/50 px-6 py-10 sm:px-12">
    <div class="grid gap-6 text-center sm:grid-cols-4">
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">{liveCourses.length}</p>
        <p class="mt-1 text-sm text-ink-600">
          <LangText lang="ar">كورسات متخصصة</LangText>
          <LangText lang="en">specialized courses</LangText>
        </p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">40+</p>
        <p class="mt-1 text-sm text-ink-600">
          <LangText lang="ar">أداة تفاعلية</LangText>
          <LangText lang="en">interactive tools</LangText>
        </p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">100%</p>
        <p class="mt-1 text-sm text-ink-600">
          <LangText lang="ar">مجاني بالكامل</LangText>
          <LangText lang="en">free forever</LangText>
        </p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">AR</p>
        <p class="mt-1 text-sm text-ink-600">
          <LangText lang="ar">محتوى عربي أصيل</LangText>
          <LangText lang="en">authentic Arabic content</LangText>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
