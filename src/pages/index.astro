---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeLearningWidget from '../components/islands/progress/ResumeLearningWidget.tsx';
import { courses } from '../data/courses';
import { curriculum } from '../data/curriculum';

const liveCourses = courses.filter((c) => c.status === 'live');
const plannedCourses = courses.filter((c) => c.status === 'planned');

const perCourse = liveCourses.map((c) => {
  const stations = curriculum.filter((s) => (s.courseId ?? 'cfm') === c.id).length;
  const lessons = curriculum
    .filter((s) => (s.courseId ?? 'cfm') === c.id)
    .reduce((acc, s) => acc + s.lessons.filter((l) => l.status === 'live').length, 0);
  return { course: c, stations, lessons };
});

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'GridFix Academy',
  url: 'https://academy.gridfix.net',
  description: 'منصة تعليمية عربية مجانية لإدارة المنشآت والصيانة وإدارة الأصول.',
  inLanguage: 'ar',
  parentOrganization: { '@type': 'Organization', name: 'GridFix', url: 'https://gridfix.net' },
};
---

<BaseLayout title="GridFix Academy — تعلم CFM وCMRP وCAMA مجاناً بالعربية" description="منصة تعليمية عربية مجانية مقدمة من GridFix: كورسات منظمة لشهادات CFM وCMRP وCAMA بالعربية مع المصطلحات الإنجليزية وأدوات تفاعلية.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-l from-ink-900 via-brand-800 to-brand-600 px-6 py-16 text-center text-white sm:px-12">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 -start-24 h-64 w-64 rounded-full bg-brand-400/10 blur-3xl"></div>
      <div class="absolute -bottom-24 -end-24 h-64 w-64 rounded-full bg-amber-400/10 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-2xl">
      <span class="chip bg-amber-400 text-amber-950">منصة تعليمية مجانية بالكامل</span>
      <h1 class="mt-5 text-3xl font-bold leading-relaxed sm:text-4xl lg:text-5xl">
        تعلّم إدارة المنشآت والصيانة <span class="text-amber-300">باحتراف</span>
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-teal-50">
        أكاديمية <strong class="text-amber-300">GridFix Academy</strong> تقدّم كورسات عربية
        عملية لأشهر شهادات المجال — مع شرح بالمصطلحات الإنجليزية، أدوات تفاعلية، وكويزات مواقف. اختر مسارك وابدأ الآن.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm text-teal-50">
        <span class="flex items-center gap-2">
          <span class="font-bold text-amber-300">{liveCourses.length}</span> كورس متاح
        </span>
        <span class="flex items-center gap-2">
          <span class="font-bold text-amber-300">{perCourse.reduce((a, c) => a + c.stations, 0)}</span> محطة
        </span>
        <span class="flex items-center gap-2">
          <span class="font-bold text-amber-300">{perCourse.reduce((a, c) => a + c.lessons, 0)}</span> درساً
        </span>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        {liveCourses[0] && (
          <a href={`/${liveCourses[0].id}`} class="rounded-xl bg-amber-400 px-6 py-3 font-bold text-amber-950 transition hover:bg-amber-300">
            ابدأ التعلم مجاناً ←
          </a>
        )}
        <a href={`/${liveCourses[0]?.id ?? 'cfm'}/map`} class="rounded-xl border border-white/30 px-6 py-3 font-bold text-white transition hover:bg-white/10">
          خريطة المنهج
        </a>
      </div>
    </div>
  </section>

  <div class="mt-8 mx-auto max-w-2xl">
    <ResumeLearningWidget client:load />
  </div>

  <section class="mt-12">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-xl font-bold text-ink-900">اختر كورسك</h2>
        <p class="mt-1 text-sm text-ink-400">كل كورس مسار مستقل: محطات، أدوات، وقاموس خاص به.</p>
      </div>
    </div>

    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {liveCourses.map((c) => {
        const stats = perCourse.find((p) => p.course.id === c.id);
        return (
          <a href={`/${c.id}`} class="card group overflow-hidden transition hover:border-brand-500 hover:shadow-md">
            <div class="flex items-start justify-between bg-gradient-to-l from-ink-900 to-brand-700 px-6 py-5 text-white">
              <div class="flex items-center gap-3">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 text-2xl transition-transform duration-300 group-hover:scale-110">{c.icon}</span>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-lg font-bold">{c.title}</h3>
                    <span class="chip bg-amber-400 text-amber-950" dir="ltr">{c.code}</span>
                  </div>
                  <p class="mt-0.5 text-xs text-teal-50">{c.titleEn}</p>
                </div>
              </div>
              <span class="chip bg-emerald-400/20 text-emerald-200">متاح الآن</span>
            </div>
            <div class="px-6 py-5">
              <p class="text-sm leading-relaxed text-ink-600">{c.description}</p>
              <div class="mt-4 flex items-center justify-between text-sm">
                <span class="flex flex-wrap gap-2">
                  <span class="chip bg-slate-100 text-ink-600">🗺 {stats?.stations} محطات</span>
                  <span class="chip bg-slate-100 text-ink-600">📚 {stats?.lessons} دروس</span>
                </span>
                <span class="font-bold text-brand-600 transition group-hover:-translate-x-1">← ابدأ التعلم</span>
              </div>
            </div>
          </a>
        );
      })}

      {plannedCourses.map((c) => (
        <div class="card overflow-hidden opacity-80">
          <div class="flex items-start justify-between bg-gradient-to-l from-slate-500 to-slate-700 px-6 py-5 text-white">
            <div class="flex items-center gap-3">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 text-2xl">{c.icon}</span>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-bold">{c.title}</h3>
                  <span class="chip bg-slate-100 text-ink-700" dir="ltr">{c.code}</span>
                </div>
                <p class="mt-0.5 text-xs text-slate-200">{c.titleEn}</p>
              </div>
            </div>
            <span class="chip bg-amber-400/20 text-amber-200">قريباً</span>
          </div>
          <div class="px-6 py-5">
            <p class="text-sm leading-relaxed text-ink-600">{c.description}</p>
            <div class="mt-4">
              <span class="chip bg-slate-100 text-ink-600">سيُطلق قريباً — اشترك ليصلك التنبيه</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-12 grid gap-4 sm:grid-cols-3">
    {[
      { icon: '🎯', title: 'مسارات منظمة بالمحطات', desc: 'محطات متسلسلة من التأسيس للتمكين مع أوزان الامتحان' },
      { icon: '🛠', title: 'أدوات تفاعلية تطبيقية', desc: 'أكثر من 40 أداة عملية لتطبيق المفاهيم فعلياً' },
      { icon: '📝', title: 'كويزات محاكية للامتحان', desc: 'سيناريوهات حقيقية مع تقييم فوري وتشخيص' },
    ].map((item) => (
      <div class="card flex flex-col items-center gap-3 p-6 text-center">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-3xl transition-transform duration-300 hover:scale-110">
          {item.icon}
        </span>
        <h3 class="font-bold text-ink-900">{item.title}</h3>
        <p class="text-sm leading-relaxed text-ink-500">{item.desc}</p>
      </div>
    ))}
  </section>

  <section class="mt-12 rounded-3xl bg-gradient-to-l from-brand-50 to-brand-100/50 px-6 py-10 sm:px-12">
    <div class="grid gap-6 text-center sm:grid-cols-4">
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">{liveCourses.length}+</p>
        <p class="mt-1 text-sm text-ink-600">كورس متاح</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">40+</p>
        <p class="mt-1 text-sm text-ink-600">أداة تفاعلية</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">100%</p>
        <p class="mt-1 text-sm text-ink-600">مجاني بالكامل</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand-700" dir="ltr">AR</p>
        <p class="mt-1 text-sm text-ink-600">محتوى عربي أصيل</p>
      </div>
    </div>
  </section>
</BaseLayout>
