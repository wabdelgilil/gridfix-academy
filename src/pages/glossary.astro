---
import BaseLayout from '../layouts/BaseLayout.astro';
import { glossary } from '../data/glossary';
---

<BaseLayout title="قاموس المصطلحات — منصة CFM" description="قاموس مركزي قابل للبحث لمصطلحات إدارة المنشآت بالعربية والإنجليزية.">
  <div class="mx-auto max-w-3xl">
    <header class="mb-6">
      <h1 class="text-2xl font-bold text-ink-900">📖 قاموس المصطلحات المركزية</h1>
      <p class="mt-1 text-sm text-ink-400">مصطلحات إدارة المنشآت بالعربية مع التعريف الإنجليزي — أساس النجاح في الامتحان.</p>
    </header>

    <div class="relative mb-6">
      <span class="pointer-events-none absolute start-4 top-1/2 -translate-y-1/2 text-ink-400">🔍</span>
      <input
        id="glossary-search"
        type="search"
        placeholder="ابحث في القاموس..."
        class="w-full rounded-xl border border-slate-200 bg-white px-11 py-3 text-sm text-ink-900 shadow-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
      />
    </div>

    <div id="glossary-list" class="grid gap-3">
      {glossary.map((term) => (
        <div
          class="card p-5 glossary-item"
          data-search={`${term.term} ${term.abbreviation ?? ''} ${term.ar} ${term.en}`.toLowerCase()}
        >
          <div class="flex flex-wrap items-center gap-2">
            <span dir="ltr" lang="en" class="font-bold text-brand-700">{term.term}</span>
            {term.abbreviation && (
              <span class="chip bg-brand-100 text-brand-700" dir="ltr">{term.abbreviation}</span>
            )}
          </div>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{term.ar}</p>
          <p dir="ltr" lang="en" class="mt-2 text-xs leading-relaxed text-ink-400">{term.en}</p>
        </div>
      ))}
    </div>

    <p id="glossary-empty" class="mt-6 hidden text-center text-sm text-ink-400">لا توجد نتائج مطابقة لبحثك.</p>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('glossary-search') as HTMLInputElement | null;
  const empty = document.getElementById('glossary-empty');
  const items = Array.from(document.querySelectorAll('.glossary-item'));

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const item of items) {
      const match =
        q === '' || (item.getAttribute('data-search') ?? '').includes(q);
      item.classList.toggle('hidden', !match);
      if (match) visible++;
    }
    empty?.classList.toggle('hidden', visible > 0);
  });
</script>