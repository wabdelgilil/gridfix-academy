---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { courses } from '../data/courses';
import { curriculum } from '../data/curriculum';
import { audioLessons } from '../data/audioManifest';

function getCourseAudioCount(courseId: string): number {
  const stations = curriculum.filter((s) => (s.courseId ?? 'cfm') === courseId);
  return stations.reduce((acc, station) => {
    return acc + station.lessons.filter((l) => Boolean(audioLessons[l.id])).length;
  }, 0);
}

function getCourseTotalLessons(courseId: string): number {
  const stations = curriculum.filter((s) => (s.courseId ?? 'cfm') === courseId);
  return stations.reduce((acc, station) => acc + station.lessons.length, 0);
}
---

<BaseLayout
  title="ادرس أثناء القيادة — المشغل الصوتي المخصص | GridFix Academy"
  titleEn="Drive & Learn — Car Audio Mode | GridFix Academy"
  description="مشغل صوتي حر بدون شاشات مخصص للتعلم أثناء قيادة السيارة والتنقل اليومي، مع إمكانية اختيار الكورس والدرس بحرية."
>
  <div class="mx-auto max-w-5xl py-6 sm:py-10 px-4 sm:px-6">
    <div class="mb-6">
      <Breadcrumb
        items={[
          { label: 'الرئيسية', href: '/' },
          { label: 'ادرس أثناء القيادة 🚗', labelEn: 'Drive & Learn' }
        ]}
      />
    </div>

    <!-- Hero Section -->
    <div class="relative overflow-hidden rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 p-6 sm:p-10 text-white shadow-2xl">
      <div class="relative z-10 max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/20 px-4 py-1 text-xs font-bold text-emerald-300 border border-emerald-500/30 mb-4">
          <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>🚗 ادرس أثناء القيادة | Drive & Learn</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-white leading-tight">
          تعلم واستمع لدروسك المفضلة <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-brand-400 bg-clip-text text-transparent">
            بدون لمس الشاشة وأثناء القيادة
          </span>
        </h1>

        <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
          مشغل تفاعلي يدعم البلوتوث وأزرار عجلة القيادة، مصمم بنصوص علمية موثقة وخالية من الحشو. اختر كورس تخصصك وحدد الدرس الذي ترغب في الاستماع إليه مباشرة.
        </p>
      </div>

      <div class="absolute left-6 -bottom-6 text-9xl opacity-10 select-none pointer-events-none">
        🚗
      </div>
    </div>

    <!-- Courses Selection Grid -->
    <div class="mt-8 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
          اختر الكورس التعليمي للاستماع:
        </h2>
        <span class="text-xs text-slate-500">
          3 مسارات مهنية متوفرة
        </span>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {courses.map((course) => {
          const audioCount = getCourseAudioCount(course.id);
          const totalLessons = getCourseTotalLessons(course.id);
          const hasAudio = audioCount > 0;

          return (
            <div
              class={`flex flex-col justify-between rounded-3xl border p-6 transition-all shadow-sm ${
                hasAudio
                  ? 'border-emerald-500/40 bg-gradient-to-b from-white to-emerald-50/30 dark:from-slate-900 dark:to-emerald-950/20 hover:shadow-md hover:border-emerald-500'
                  : 'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 opacity-90'
              }`}
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-4xl">{course.icon}</span>
                  {hasAudio ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
                      <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                      <span>جاهز للاستماع ({audioCount} دروس)</span>
                    </span>
                  ) : (
                    <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-500">
                      🎙️ قيد الإنتاج
                    </span>
                  )}
                </div>

                <div class="text-xs font-bold text-brand-600 dark:text-brand-400">
                  شهادة {course.code}
                </div>
                <h3 class="mt-1 text-lg font-bold text-slate-900 dark:text-white">
                  {course.title}
                </h3>
                <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3">
                  {course.description}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 space-y-2">
                <div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 mb-3">
                  <span>إجمالي الدروس: {totalLessons} درس</span>
                  <span>{hasAudio ? `${audioCount} متاح صوتياً` : 'قريباً'}</span>
                </div>

                <a
                  href={`/${course.id}/listen/?playlist=true`}
                  class={`w-full flex items-center justify-center gap-2 rounded-2xl py-3 px-4 text-sm font-bold transition shadow-xs ${
                    hasAudio
                      ? 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white hover:from-emerald-500 hover:to-teal-500 shadow-emerald-600/20'
                      : 'bg-slate-800 text-slate-200 hover:bg-slate-700'
                  }`}
                >
                  <span>🚗</span>
                  <span>{hasAudio ? 'فتح مشغل وضع القيادة' : 'استعراض قائمة الدروس'}</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Car Mode Instructions -->
    <div class="mt-12 rounded-3xl border border-slate-200 bg-slate-50/80 p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900/50">
      <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>💡</span>
        <span>كيف يعمل وضع القيادة (Drive & Learn)؟</span>
      </h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
        <div class="rounded-2xl bg-white p-4 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-2xs">
          <div class="font-bold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
            <span>🔘</span>
            <span>تحكم عجلة القيادة</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">
            استخدم أزرار التالي والسابق على مقود السيارة للتنقل بين الدروس أو تقديم وتأخير الدرس 15 ثانية.
          </p>
        </div>

        <div class="rounded-2xl bg-white p-4 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-2xs">
          <div class="font-bold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
            <span>☀️</span>
            <span>إبقاء الشاشة مضاءة</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">
            تظل شاشة الهاتف أو التابلت مضاءة تلقائياً طالما أن المشغل يعمل لتتمكن من النظر بسرعة للعنوان.
          </p>
        </div>

        <div class="rounded-2xl bg-white p-4 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-2xs">
          <div class="font-bold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
            <span>🔄</span>
            <span>التشغيل المتواصل</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">
            ينتقل المشغل تلقائياً إلى الدرس التالي فور انتهاء الدرس الحالي لتستمتع بمسار تعليمي متكامل بدون تشتيت.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
