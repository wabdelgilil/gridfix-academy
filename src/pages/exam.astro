---
import BaseLayout from '../layouts/BaseLayout.astro';
import MockExam from '../components/islands/tools/MockExam.tsx';
---

<BaseLayout title="محاكي الامتحان النهائي — منصة CFM" description="محاكي حقيقي لامتحان CFM: أسئلة مواقف، مؤقت زمني، وتقرير تشخيصي حسب أركان المنهج.">
  <div class="mx-auto max-w-3xl">
    <header class="mb-6">
      <span class="chip bg-brand-100 text-brand-700">🧪 تدريب فعلي</span>
      <h1 class="mt-3 text-2xl font-bold text-ink-900">📝 محاكي امتحان CFM النهائي</h1>
      <p class="mt-2 text-sm leading-relaxed text-ink-500">
        أسئلة مواقف حقيقية من كل أركان المنهج (تشغيل، طوارئ، استدامة، قيادة، إدارة مشاريع...) مع مؤقت يحاكي إيقاع
        الامتحان الفعلي (90 ثانية للسؤال) وتقرير يبين أضعف ركن لديك بعد كل محاولة. اجمع 60% فأكثر لتعتبر جاهزاً،
        وكرر حتى تتجاوز 70%.
      </p>
    </header>

    <MockExam client:load />
  </div>
</BaseLayout>