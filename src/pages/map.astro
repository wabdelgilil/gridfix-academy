---
import BaseLayout from '../layouts/BaseLayout.astro';
import { curriculum } from '../data/curriculum';

const stations = [...curriculum].sort((a, b) => a.number - b.number);
const totalMinutes = stations.reduce((acc, s) => acc + s.lessons.reduce((t, l) => t + l.minutes, 0), 0);
---

<BaseLayout title="خريطة منهج CFM — منصة CFM" description="الخريطة الكاملة لمسار منصة CFM: المحطات والدروس والأدوات ووزن كل ركن في الامتحان.">
  <div class="mx-auto max-w-4xl">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="chip bg-brand-100 text-brand-700">🗺️ المسار الكامل</span>
        <h1 class="mt-3 text-2xl font-bold text-ink-900">خريطة المنهج</h1>
        <p class="mt-2 text-sm leading-relaxed text-ink-500">
          {stations.length} محطة • {curriculum.reduce((a, s) => a + s.lessons.length, 0)} درساً • نحو {Math.round(totalMinutes / 60)} ساعة تعلم.
          الأرقام على كل محطة تشير إلى وزن الركن التقريبي في امتحان CFM.
        </p>
      </div>
      <span class="chip bg-amber-100 text-amber-800">✅ كل المحطات متاحة الآن</span>
    </header>

    <ol class="relative space-y-6 border-s-2 border-slate-200 ps-6">
      {stations.map((s) => {
        const live = s.lessons.filter((l) => l.status === 'live');
        const total = s.lessons.length;
        return (
          <li class="relative">
            <span class="absolute -start-[34px] top-3 flex h-7 w-7 items-center justify-center rounded-full bg-white text-sm shadow ring-1 ring-slate-200">
              {s.icon}
            </span>

            <a
              href={`/stations/${s.id}`}
              class="card block rounded-2xl p-5 transition hover:border-brand-500 hover:shadow-md"
            >
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <h2 class="font-bold text-ink-900">
                    <span class="text-brand-600">محطة {s.number}</span> — {s.title}
                  </h2>
                  <span dir="ltr" lang="en" class="text-xs text-ink-400">{s.titleEn}</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  {s.examWeight > 0 && s.examWeight < 100 && (
                    <span class="chip bg-amber-50 text-amber-800">◉ {s.examWeight}% من الامتحان</span>
                  )}
                  <span class={`chip ${live.length === total ? 'bg-brand-100 text-brand-700' : 'bg-amber-100 text-amber-800'}`}>
                    {live.length === total ? '✅ مكتملة' : '⏳ قيد البناء'}
                  </span>
                </div>
              </div>

              <p class="mt-2 text-sm leading-relaxed text-ink-500">{s.description}</p>

              <ul class="mt-3 flex flex-wrap gap-1.5">
                {s.lessons.map((l) => (
                  <li class="flex items-center">
                    {l.status === 'live' ? (
                      <a
                        href={`/lessons/${l.id}`}
                        class="rounded-lg bg-slate-50 px-2.5 py-1 text-xs font-semibold text-ink-600 transition hover:bg-brand-50 hover:text-brand-700"
                      >
                        {l.number} {l.title} {l.toolName ? `🛠 ${l.toolName}` : ''}
                      </a>
                    ) : (
                      <span class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-ink-400">{l.number} {l.title} • قريباً</span>
                    )}
                  </li>
                ))}
              </ul>
            </a>
          </li>
        );
      })}
    </ol>

    <p class="mt-8 rounded-xl bg-slate-100 p-4 text-center text-sm leading-relaxed text-ink-500">
      الترتيب يعكس مسار مدير المنشأة الواقعي: تأسيس ← تشغيل ← عقارات ← مالية ← رفاهية ← سلامة ← طوارئ ← استدامة ←
      قيادة ← تقنية ← جودة ← محاكي ← مشاريع. ابدأ من محطة 0 وامضِ بالترتيب أو انتقل مباشرة لأي ركن تريده.
    </p>
  </div>
</BaseLayout>