---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="الصفحة غير موجودة — GridFix Academy" description="الصفحة المطلوبة غير موجودة. عُد إلى مسارات التعلم في GridFix Academy." noindex={true}>
  <div class="mx-auto max-w-2xl py-16 text-center">
    <span class="text-7xl">🧭</span>
    <h1 class="mt-6 text-4xl font-black text-ink-900">404 — خرجت عن المسار</h1>
    <p class="mt-3 leading-relaxed text-ink-500">
      الصفحة التي تبحث عنها غير موجودة أو نُقلت. لا بأس — أفضل المهندسين يعيدون المعايرة ثم يكملون الطريق.
    </p>
    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <a href="/cfm" class="card p-5 transition hover:border-brand-500 hover:shadow-md">
        <span class="text-3xl">🏗️</span>
        <p class="mt-2 font-bold text-ink-900">مسار CFM</p>
        <p class="mt-1 text-xs text-ink-400">إدارة المنشآت — متاح الآن</p>
      </a>
      <a href="/cmrp" class="card p-5 transition hover:border-brand-500 hover:shadow-md">
        <span class="text-3xl">⚙️</span>
        <p class="mt-2 font-bold text-ink-900">مسار CMRP</p>
        <p class="mt-1 text-xs text-ink-400">الصيانة والموثوقية — متاح الآن</p>
      </a>
      <a href="/" class="card p-5 transition hover:border-brand-500 hover:shadow-md">
        <span class="text-3xl">🏠</span>
        <p class="mt-2 font-bold text-ink-900">الرئيسية</p>
        <p class="mt-1 text-xs text-ink-400">اختيار الكورس من البداية</p>
      </a>
    </div>
  </div>
</BaseLayout>
