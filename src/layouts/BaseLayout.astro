---
import SiteHeader from '../components/islands/SiteHeader.tsx';
import '../styles/global.css';
import type { Language } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  dir?: 'rtl' | 'ltr';
}

const {
  title,
  description = 'منصة تعلم شهادة CFM — إدارة المنشآت',
  lang = 'ar',
  dir = 'rtl',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://cfm-course.example.com');
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader client:load />

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="grid gap-6 text-sm leading-relaxed text-ink-600 md:grid-cols-3">
          <div>
            <div class="mb-2 flex items-center gap-2">
              <img src="/favicon.svg" alt="" width="26" height="26" />
              <span class="font-bold text-ink-900">منصة CFM</span>
            </div>
            <p>مسارك العملي لشهادة مدير المنشآت — تعلّم بالعربي والمصطلحات الإنجليزية.</p>
            <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-800">
              💚 منصة تعليمية <strong>مجانية بالكامل</strong>
            </p>
          </div>
          <div>
            <p class="mb-2 font-semibold text-ink-900">محتوى تعليمي</p>
            <p>دروس ببنية موحدة: شرح + مصطلحات + أداة تفاعلية + كويز سيناريو + مصادر موثوقة.</p>
          </div>
          <div>
            <p class="mb-2 font-semibold text-ink-900">مقدمة من GridFix</p>
            <p>
              هذه المنصة التعليمية مقدمة مجاناً من{' '}
              <a href="https://gridfix.net" target="_blank" rel="noopener" class="font-semibold text-brand-700 underline-offset-4 hover:underline">
                gridfix.net
              </a>{' '}
              — تجمع خبرة عملية في إدارة المنشآت والمرافق.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href="https://gridfix.net" target="_blank" rel="noopener" class="rounded-lg bg-ink-900 px-3 py-1.5 text-xs font-semibold text-teal-100 transition hover:bg-ink-800">
                ⚡ زيارة GridFix
              </a>
            </div>
          </div>
          <div class="text-xs text-ink-400 md:col-span-3">
            <p>المنصة ليست جهة اعتماد رسمية. للأهلية والمواعيد والرسوم الحالية، راجع موقع IFMA الرسمي.</p>
            <p class="mt-2">© {new Date().getFullYear()} منصة CFM — GridFix. جميع الحقوق محفوظة.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>