---
import SiteHeader from '../components/islands/SiteHeader.tsx';
import SearchPalette from '../components/islands/SearchPalette.tsx';
import '../styles/global.css';
import type { Language } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  dir?: 'rtl' | 'ltr';
  noindex?: boolean;
  image?: string;
}

const {
  title,
  description = 'GridFix Academy — منصة التعليم المهني لإدارة المنشآت والصيانة',
  lang = 'ar',
  dir = 'rtl',
  noindex = false,
  image = '/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://academy.gridfix.net');
const ogImage = new URL(image, Astro.site ?? 'https://academy.gridfix.net').toString();
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var t = localStorage.getItem('cfm-theme');
        var d = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (d) document.documentElement.classList.add('dark');
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="GridFix Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader client:load />
    <SearchPalette client:load />

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-white transition-colors duration-300 hover:border-brand-200">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="grid gap-6 text-sm leading-relaxed text-ink-600 md:grid-cols-3">
          <div class="animate-fade-in">
            <div class="mb-2 flex items-center gap-2">
              <img src="/favicon.svg" alt="" width="26" height="26" class="transition-transform duration-200 hover:scale-110" />
              <span class="font-bold text-ink-900">GridFix Academy</span>
            </div>
            <p data-lang="ar">منصة تعليمية مهنية بالعربية لشهادات إدارة المنشآت والصيانة — كل كورس مسار منظم بمحطات وأدوات وقاموس خاص به.</p>
            <p data-lang="en" lang="en" dir="ltr">A professional Arabic learning platform for facility management and maintenance credentials — each course is an organized path with stations, tools, and its own glossary.</p>
            <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-800 transition-colors duration-200 hover:bg-brand-100">
              💚 <span data-lang="ar">منصة تعليمية <strong>مجانية بالكامل</strong></span>
              <span data-lang="en" lang="en" dir="ltr">A <strong>100% free</strong> learning platform</span>
            </p>
          </div>
          <div class="animate-fade-in" style="animation-delay: 100ms">
            <p class="mb-2 font-semibold text-ink-900">
              <span data-lang="ar">كورسات المنصة</span>
              <span data-lang="en" lang="en" dir="ltr">Our Courses</span>
            </p>
            <p data-lang="ar">CFM لإدارة المنشآت • CMRP للصيانة والموثوقية — مسارك القادم.</p>
            <p data-lang="en" lang="en" dir="ltr">CFM for facility management • CMRP for maintenance &amp; reliability — your next path.</p>
          </div>
          <div class="animate-fade-in" style="animation-delay: 200ms">
            <p class="mb-2 font-semibold text-ink-900">
              <span data-lang="ar">مقدمة من GridFix</span>
              <span data-lang="en" lang="en" dir="ltr">Powered by GridFix</span>
            </p>
            <p data-lang="ar">
              هذه المنصة التعليمية مقدمة مجاناً من{' '}
              <a
                href="https://gridfix.net"
                target="_blank"
                rel="noopener"
                class="font-semibold text-brand-700 underline-offset-4 transition-all duration-200 hover:underline hover:text-brand-800"
              >
                gridfix.net
              </a>{' '}
              — تجمع خبرة عملية في إدارة المنشآت والمرافق.
            </p>
            <p data-lang="en" lang="en" dir="ltr">
              This learning platform is offered for free by{' '}
              <a
                href="https://gridfix.net"
                target="_blank"
                rel="noopener"
                class="font-semibold text-brand-700 underline-offset-4 transition-all duration-200 hover:underline hover:text-brand-800"
              >
                gridfix.net
              </a>{' '}
              — bringing hands-on experience in facility and property management.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href="https://gridfix.net"
                target="_blank"
                rel="noopener"
                class="btn btn-sm bg-ink-900 text-teal-100 transition-all duration-200 hover:bg-ink-800 hover:shadow-md"
              >
                <span data-lang="ar">⚡ زيارة GridFix</span>
                <span data-lang="en" lang="en" dir="ltr">⚡ Visit GridFix</span>
              </a>
            </div>
          </div>
          <div class="text-xs text-ink-400 md:col-span-3 border-t border-slate-100 pt-4 mt-4">
            <p data-lang="ar">المنصة ليست جهة اعتماد رسمية. للأهلية والمواعيد والرسوم الحالية، راجع موقع الجهة المانحة (IFMA أو SMRP) الرسمي.</p>
            <p data-lang="en" lang="en" dir="ltr">This platform is not an official certifying body. For current eligibility, dates, and fees, check the official issuing body's website (IFMA or SMRP).</p>
            <p class="mt-2">© {new Date().getFullYear()} GridFix Academy. <span data-lang="ar">جميع الحقوق محفوظة.</span><span data-lang="en" lang="en" dir="ltr">All rights reserved.</span></p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
