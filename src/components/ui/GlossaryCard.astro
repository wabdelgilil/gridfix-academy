---
import { glossary, type GlossaryTerm } from '../../data/glossary';

interface Props {
  terms: string[];
}
const { terms } = Astro.props;

const items: GlossaryTerm[] = terms
  .map((id) => glossary.find((g) => g.id === id))
  .filter((g): g is GlossaryTerm => Boolean(g));
---

<div class="card mt-8 overflow-hidden">
  <div class="border-b border-slate-200 bg-slate-50 px-5 py-3 text-sm font-semibold text-ink-900">
    📖 قاموس المصطلحات
  </div>
  <div class="divide-y divide-slate-100">
    {items.map((item) => (
      <div class="px-5 py-4">
        <div class="flex flex-wrap items-center gap-2">
          <span dir="ltr" lang="en" class="font-semibold text-brand-700">
            {item.term}
          </span>
          {item.abbreviation && (
            <span class="chip bg-brand-100 text-brand-700" dir="ltr">{item.abbreviation}</span>
          )}
        </div>
        <p class="mt-1 text-sm leading-relaxed text-ink-600">{item.ar}</p>
      </div>
    ))}
  </div>
</div>