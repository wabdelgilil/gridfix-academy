---
type CurveGroup = 'age' | 'random';

interface CurveItem {
  letter: 'A' | 'B' | 'C' | 'D' | 'E' | 'F';
  label: string;
  percent: string;
  group: CurveGroup;
}

interface Props {
  curves: CurveItem[];
  title?: string;
  caption?: string;
  axisLabel?: string;
  ageLabel?: string;
  randomLabel?: string;
}

const {
  curves,
  title,
  caption,
  axisLabel = 'time',
  ageLabel = 'Age-related',
  randomLabel = 'Random, non-age-related',
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 7);

const shapePoints: Record<string, Array<[number, number]>> = {
  F: [
    [0, 55],
    [5, 40],
    [12, 22],
    [26, 13],
    [42, 10],
    [70, 9],
    [100, 9],
  ],
  E: [
    [0, 25],
    [100, 25],
  ],
  D: [
    [0, 9],
    [16, 13],
    [32, 22],
    [50, 25],
    [75, 25],
    [100, 25],
  ],
  C: [
    [0, 9],
    [18, 14],
    [38, 24],
    [58, 36],
    [78, 48],
    [100, 58],
  ],
  A: [
    [0, 55],
    [7, 42],
    [20, 16],
    [45, 9],
    [72, 10],
    [90, 28],
    [100, 54],
  ],
  B: [
    [0, 7],
    [70, 7],
    [86, 14],
    [94, 48],
    [100, 58],
  ],
};

const groupStyles: Record<CurveGroup, string> = {
  age: 'border-teal-300/80 bg-teal-50/50 dark:border-teal-800/50 dark:bg-teal-950/25 shadow-xs',
  random: 'border-rose-300/80 bg-rose-50/50 dark:border-rose-800/50 dark:bg-rose-950/25 shadow-xs',
};

const groupBadge: Record<CurveGroup, string> = {
  age: 'bg-teal-100 text-teal-800 dark:bg-teal-950/80 dark:text-teal-300 ring-1 ring-inset ring-teal-200/50 dark:ring-teal-800/50',
  random: 'bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 ring-1 ring-inset ring-rose-200/50 dark:ring-rose-800/50',
};

const letterStyle: Record<CurveGroup, string> = {
  age: 'bg-teal-700 dark:bg-teal-600',
  random: 'bg-rose-700 dark:bg-rose-600',
};

const color = {
  age: '#0d9488',
  random: '#e11d48',
};

const cleanLabel = (s: string) => s.replace(/[→←↑↓]/g, '').trim();

const sx = (x: number) => 16 + (x / 100) * 132;
const sy = (h: number) => 72 - h;

function smoothPath(points: Array<[number, number]>): string {
  if (points.length < 2) return '';
  const pts = points.map(([x, h]) => ({ x: sx(x), y: sy(h) }));
  const d = [`M${pts[0].x},${pts[0].y}`];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d.push(`C${c1x},${c1y} ${c2x},${c2y} ${p2.x},${p2.y}`);
  }
  return d.join(' ');
}

function areaPath(points: Array<[number, number]>): string {
  return `${smoothPath(points)} L${sx(100)},72 L${sx(0)},72 Z`;
}
---

<div class="my-6">
  {title && (
    <div class="mb-3.5 flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-500" />
      <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{title}</p>
    </div>
  )}
  <div class="grid grid-cols-2 items-start gap-3.5 lg:grid-cols-3">
    {curves.map((c) => (
      <figure class={`overflow-hidden rounded-xl border p-1 transition-all ${groupStyles[c.group]}`}>
        <figcaption class="flex items-start justify-between gap-2 px-2.5 pt-2">
          <span class="flex items-center gap-1.5">
            <span
              class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-xs font-black text-white shadow-xs ${letterStyle[c.group]}`}>
              {c.letter}
            </span>
            <span class="text-xs font-bold leading-tight text-ink-900 dark:text-slate-100">{c.label}</span>
          </span>
          <span
            class={`shrink-0 rounded-full px-2 py-0.5 text-[11px] font-bold ${groupBadge[c.group]}`}
            dir="ltr">{c.percent}</span>
        </figcaption>
        <svg viewBox="0 0 160 96" class="mt-1 w-full" role="img" aria-label={`${c.label} ${c.percent}`}>
          <style>
            .cs-grid { stroke: #e2e8f0; }
            .cs-axis { stroke: #94a3b8; }
            .cs-arrow { fill: #94a3b8; }
            .cs-text { fill: #64748b; }
            :global(.dark) .cs-grid { stroke: #334155; }
            :global(.dark) .cs-axis { stroke: #475569; }
            :global(.dark) .cs-arrow { fill: #475569; }
            :global(.dark) .cs-text { fill: #94a3b8; }
          </style>
          <defs>
            <linearGradient id={`${uid}-${c.letter}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color={color[c.group]} stop-opacity="0.22" />
              <stop offset="100%" stop-color={color[c.group]} stop-opacity="0.02" />
            </linearGradient>
          </defs>
          <line x1="16" y1="40" x2="148" y2="40" class="cs-grid" stroke-width="1" stroke-dasharray="3 4" />
          <line x1="16" y1="24" x2="148" y2="24" class="cs-grid" stroke-width="1" stroke-dasharray="3 4" />
          <path d={areaPath(shapePoints[c.letter])} fill={`url(#${uid}-${c.letter})`} stroke="none" />
          <line x1="16" y1="72" x2="150" y2="72" class="cs-axis" stroke-width="1.2" />
          <path d="M151,73 L145,69.5 L145,76.5 Z" class="cs-arrow" />
          <line x1="16" y1="72" x2="16" y2="10" class="cs-axis" stroke-width="1.2" />
          <path d="M12,12 L16,5 L20,11.5 Z" class="cs-arrow" />
          <path
            d={smoothPath(shapePoints[c.letter])}
            fill="none"
            stroke={color[c.group]}
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <text
            x="148"
            y="86"
            font-size="8.5"
            class="cs-text"
            text-anchor="end">{cleanLabel(axisLabel)}</text>
        </svg>
        <div class="px-2 pb-2 pt-1 text-center">
          <span class={`inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold ${groupBadge[c.group]}`}>
            {c.group === 'age' ? ageLabel : randomLabel}
          </span>
        </div>
      </figure>
    ))}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400 dark:text-slate-400">{caption}</p>}
</div>