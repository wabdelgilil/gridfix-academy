---
interface Phase {
  title: string;
  detail?: string;
  icon?: string;
  duration?: string;
}

interface Props {
  phases: Phase[];
  title?: string;
  caption?: string;
}

const { phases, title, caption } = Astro.props;
---

<div class="my-6">
  {title && (
    <div class="mb-3.5 flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-500" />
      <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{title}</p>
    </div>
  )}
  <ol class="relative space-y-4 border-s-2 border-brand-200 dark:border-brand-800/80 ms-4 ps-6">
    {phases.map((phase) => (
      <li class="relative">
        <span class="absolute -start-[41px] top-1.5 flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white shadow-sm ring-4 ring-white dark:ring-slate-900">
          {phase.icon ?? '•'}
        </span>
        <div class="rounded-xl border border-slate-200/90 bg-white p-3.5 shadow-xs dark:border-slate-700/80 dark:bg-slate-800/70 transition-all">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{phase.title}</p>
            {phase.duration && (
              <span class="inline-flex items-center rounded-md bg-brand-50 px-2 py-0.5 text-[11px] font-semibold text-brand-700 dark:bg-brand-950/60 dark:text-brand-300 ring-1 ring-inset ring-brand-200/60 dark:ring-brand-800/60">
                {phase.duration}
              </span>
            )}
          </div>
          {phase.detail && <p class="mt-1.5 text-xs leading-relaxed text-ink-600 dark:text-slate-300">{phase.detail}</p>}
        </div>
      </li>
    ))}
  </ol>
  {caption && <p class="mt-2 text-center text-xs text-ink-400 dark:text-slate-400">{caption}</p>}
</div>