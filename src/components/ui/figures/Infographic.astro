---
interface GridItem {
  title: string;
  detail?: string;
  icon?: string;
  color?: 'brand' | 'teal' | 'amber' | 'sky' | 'rose' | 'ink';
}

interface Props {
  items: GridItem[];
  title?: string;
  caption?: string;
  cols?: 2 | 3 | 4;
}

const { items, title, caption, cols = 3 } = Astro.props;

const colors: Record<string, string> = {
  brand: 'border-brand-200/80 bg-brand-50/50 dark:border-brand-800/50 dark:bg-brand-950/25',
  teal: 'border-teal-200/80 bg-teal-50/50 dark:border-teal-800/50 dark:bg-teal-950/25',
  amber: 'border-amber-200/80 bg-amber-50/50 dark:border-amber-800/50 dark:bg-amber-950/25',
  sky: 'border-sky-200/80 bg-sky-50/50 dark:border-sky-800/50 dark:bg-sky-950/25',
  rose: 'border-rose-200/80 bg-rose-50/50 dark:border-rose-800/50 dark:bg-rose-950/25',
  ink: 'border-slate-200/90 bg-slate-50/70 dark:border-slate-700/80 dark:bg-slate-850/50',
};

const gridCols: Record<number, string> = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<div class="my-6">
  {title && (
    <div class="mb-3.5 flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-500" />
      <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{title}</p>
    </div>
  )}
  <div class={`grid grid-cols-1 gap-3.5 ${gridCols[cols]}`}>
    {items.map((item) => (
      <div class={`flex flex-col rounded-xl border p-4 shadow-xs transition-all duration-200 hover:-translate-y-0.5 ${colors[item.color ?? 'brand']}`}>
        {item.icon && (
          <span class="mb-2.5 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/80 dark:bg-slate-800/80 text-xl shadow-xs ring-1 ring-black/5 dark:ring-white/10">
            {item.icon}
          </span>
        )}
        <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{item.title}</p>
        {item.detail && <p class="mt-1 text-xs leading-relaxed text-ink-600 dark:text-slate-300">{item.detail}</p>}
      </div>
    ))}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400 dark:text-slate-400">{caption}</p>}
</div>