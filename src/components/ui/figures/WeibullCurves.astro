---
type CurveKey = 'infant' | 'random' | 'wearout';

interface CurveData {
  key: CurveKey;
  label: string;
  note: string;
}

interface Props {
  curves: [CurveData, CurveData, CurveData];
  title?: string;
  caption?: string;
  hazardLabel?: string;
  timeLabel?: string;
}

const { curves, title, caption, hazardLabel = 'hazard rate', timeLabel = 'time' } = Astro.props;

const styles: Record<CurveKey, Record<string, string>> = {
  infant: {
    card: 'border-teal-300/80 bg-teal-50/50 dark:border-teal-800/50 dark:bg-teal-950/25 shadow-xs',
    chip: 'bg-teal-100 text-teal-800 dark:bg-teal-950/80 dark:text-teal-300 ring-1 ring-inset ring-teal-200/50 dark:ring-teal-800/50',
    color: '#0d9488',
  },
  random: {
    card: 'border-amber-300/80 bg-amber-50/50 dark:border-amber-800/50 dark:bg-amber-950/25 shadow-xs',
    chip: 'bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 ring-1 ring-inset ring-amber-200/50 dark:ring-amber-800/50',
    color: '#d97706',
  },
  wearout: {
    card: 'border-rose-300/80 bg-rose-50/50 dark:border-rose-800/50 dark:bg-rose-950/25 shadow-xs',
    chip: 'bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 ring-1 ring-inset ring-rose-200/50 dark:ring-rose-800/50',
    color: '#e11d48',
  },
};

const labels: Record<CurveKey, string> = {
  infant: 'β < 1',
  random: 'β = 1',
  wearout: 'β > 1',
};

// hazard-rate functions sampled over t in [0.5, 10], normalized to fill the plot
function hazard(key: CurveKey, t: number): number {
  switch (key) {
    case 'infant':
      return Math.pow(t / 0.5, -1.6);
    case 'random':
      return 0.5;
    case 'wearout':
      return Math.pow(t / 10, 2.8);
  }
}

const PLOT_LEFT = 10;
const PLOT_RIGHT = 112;
const PLOT_TOP = 6;
const PLOT_BOTTOM = 62;
const w = PLOT_RIGHT - PLOT_LEFT;

function curvePath(key: CurveKey): string {
  const px = (t: number) => PLOT_LEFT + (t / 10) * w;
  const py = (h: number) => PLOT_BOTTOM - (h / 1) * (PLOT_BOTTOM - PLOT_TOP);
  const pts: Array<{ x: number; y: number }> = [];
  for (let i = 0; i <= 120; i++) {
    const t = 0.5 + (i / 120) * 9.5;
    pts.push({ x: px(t), y: py(hazard(key, t)) });
  }
  const d = [`M${pts[0].x},${pts[0].y}`];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
    const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
    d.push(`C${c1.x},${c1.y} ${c2.x},${c2.y} ${p2.x},${p2.y}`);
  }
  return d.join(' ');
}
---

<div class="my-6">
  {title && (
    <div class="mb-3.5 flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-500" />
      <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{title}</p>
    </div>
  )}
  <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3">
    {curves.map((c) => (
      <div class={`rounded-xl border p-3.5 transition-all ${styles[c.key].card}`}>
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold text-ink-900 dark:text-slate-100">{c.label}</span>
          <span class={`rounded-full px-2 py-0.5 text-[11px] font-bold ${styles[c.key].chip}`} dir="ltr">{labels[c.key]}</span>
        </div>
        <svg viewBox="0 0 120 80" class="mt-2 w-full" role="img" aria-label={`${c.label} ${labels[c.key]}`}>
          <style>
            .wb-axis { stroke: #94a3b8; }
            .wb-text { fill: #64748b; }
            :global(.dark) .wb-axis { stroke: #475569; }
            :global(.dark) .wb-text { fill: #94a3b8; }
          </style>
          <line x1={PLOT_LEFT} y1={PLOT_BOTTOM} x2={PLOT_RIGHT} y2={PLOT_BOTTOM} class="wb-axis" stroke-width="1" />
          <line x1={PLOT_LEFT} y1={PLOT_BOTTOM} x2={PLOT_LEFT} y2={PLOT_TOP} class="wb-axis" stroke-width="1" />
          <path d={curvePath(c.key)} fill="none" stroke={styles[c.key].color} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <text x={PLOT_RIGHT} y="78" font-size="7" class="wb-text" text-anchor="end">{timeLabel}</text>
          <text x={PLOT_LEFT + 2} y={PLOT_TOP + 7} font-size="6.5" class="wb-text">{hazardLabel}</text>
        </svg>
        <p class="mt-1.5 text-[11px] leading-relaxed text-ink-600 dark:text-slate-300">{c.note}</p>
      </div>
    ))}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400 dark:text-slate-400">{caption}</p>}
</div>