---
interface Side {
  label: string;
  items: string[];
  color?: 'brand' | 'teal' | 'amber' | 'rose';
}

interface Props {
  sides: Side[]; // exactly 2 or 3
  title?: string;
  caption?: string;
}

const { sides, title, caption } = Astro.props;

const colors: Record<string, string> = {
  brand: 'border-brand-200 bg-brand-50',
  teal: 'border-teal-200 bg-teal-50',
  amber: 'border-amber-200 bg-amber-50',
  rose: 'border-rose-200 bg-rose-50',
};
---

<div class="my-6">
  {title && <p class="mb-3 text-sm font-bold text-ink-900">{title}</p>}
  <div class={`grid grid-cols-1 ${sides.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3'} gap-3`}>
    {sides.map((side) => (
      <div class={`flex flex-col rounded-xl border p-4 ${colors[side.color ?? 'brand']}`}>
        <p class="mb-2 text-sm font-bold text-ink-900">{side.label}</p>
        <ul class="space-y-1.5">
          {side.items.map((item) => (
            <li class="flex items-start gap-1.5 text-xs leading-relaxed text-ink-700">
              <span class="mt-0.5 shrink-0 text-brand-600">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400">{caption}</p>}
</div>