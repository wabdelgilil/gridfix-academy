---
interface Side {
  label: string;
  items: string[];
  color?: 'brand' | 'teal' | 'amber' | 'rose';
}

interface Props {
  sides: Side[]; // exactly 2 or 3
  title?: string;
  caption?: string;
}

const { sides, title, caption } = Astro.props;

const styles: Record<string, { card: string; header: string; bullet: string; icon: string }> = {
  brand: {
    card: 'border-brand-200/90 bg-brand-50/50 dark:border-brand-800/50 dark:bg-brand-950/25',
    header: 'text-brand-900 dark:text-brand-200 border-brand-200 dark:border-brand-800/60',
    bullet: 'text-brand-600 dark:text-brand-400',
    icon: '✓',
  },
  teal: {
    card: 'border-teal-200/90 bg-teal-50/50 dark:border-teal-800/50 dark:bg-teal-950/25',
    header: 'text-teal-900 dark:text-teal-200 border-teal-200 dark:border-teal-800/60',
    bullet: 'text-teal-600 dark:text-teal-400',
    icon: '✓',
  },
  amber: {
    card: 'border-amber-200/90 bg-amber-50/50 dark:border-amber-800/50 dark:bg-amber-950/25',
    header: 'text-amber-900 dark:text-amber-200 border-amber-200 dark:border-amber-800/60',
    bullet: 'text-amber-600 dark:text-amber-400',
    icon: '•',
  },
  rose: {
    card: 'border-rose-200/90 bg-rose-50/50 dark:border-rose-800/50 dark:bg-rose-950/25',
    header: 'text-rose-900 dark:text-rose-200 border-rose-200 dark:border-rose-800/60',
    bullet: 'text-rose-600 dark:text-rose-400',
    icon: '✕',
  },
};
---

<div class="my-6">
  {title && (
    <div class="mb-3.5 flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-500" />
      <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{title}</p>
    </div>
  )}
  <div class={`grid grid-cols-1 ${sides.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3'} gap-3.5`}>
    {sides.map((side) => {
      const colorKey = side.color ?? 'brand';
      const theme = styles[colorKey];
      return (
        <div class={`flex flex-col rounded-xl border p-4.5 shadow-xs transition-all ${theme.card}`}>
          <div class={`mb-3 pb-2 border-b text-sm font-bold ${theme.header}`}>
            {side.label}
          </div>
          <ul class="space-y-2">
            {side.items.map((item) => (
              <li class="flex items-start gap-2 text-xs leading-relaxed text-ink-700 dark:text-slate-300">
                <span class={`mt-0.5 shrink-0 font-bold ${theme.bullet}`}>{theme.icon}</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400 dark:text-slate-400">{caption}</p>}
</div>