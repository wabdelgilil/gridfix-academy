---
interface Stat {
  value: string;
  label: string;
  note?: string;
  color?: 'brand' | 'teal' | 'amber' | 'rose' | 'ink';
}

interface Props {
  stats: Stat[];
  title?: string;
  caption?: string;
}

const { stats, title, caption } = Astro.props;

const colors: Record<string, string> = {
  brand: 'text-brand-700',
  teal: 'text-teal-700',
  amber: 'text-amber-700',
  rose: 'text-rose-700',
  ink: 'text-ink-900',
};
---

<div class="my-6">
  {title && <p class="mb-3 text-sm font-bold text-ink-900">{title}</p>}
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    {stats.map((stat) => (
      <div class="flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white p-4 text-center">
        <p class={`text-2xl font-bold ${colors[stat.color ?? 'brand']}`} dir="ltr">{stat.value}</p>
        <p class="mt-1 text-xs font-semibold text-ink-900">{stat.label}</p>
        {stat.note && <p class="mt-0.5 text-[10px] leading-relaxed text-ink-400">{stat.note}</p>}
      </div>
    ))}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400">{caption}</p>}
</div>