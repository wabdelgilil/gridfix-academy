---
interface Stat {
  value: string;
  label: string;
  note?: string;
  color?: 'brand' | 'teal' | 'amber' | 'rose' | 'ink';
}

interface Props {
  stats: Stat[];
  title?: string;
  caption?: string;
}

const { stats, title, caption } = Astro.props;

const textColors: Record<string, string> = {
  brand: 'text-brand-600 dark:text-brand-400',
  teal: 'text-teal-600 dark:text-teal-400',
  amber: 'text-amber-600 dark:text-amber-400',
  rose: 'text-rose-600 dark:text-rose-400',
  ink: 'text-ink-900 dark:text-slate-100',
};

const topAccents: Record<string, string> = {
  brand: 'bg-brand-500',
  teal: 'bg-teal-500',
  amber: 'bg-amber-500',
  rose: 'bg-rose-500',
  ink: 'bg-slate-500',
};
---

<div class="my-6">
  {title && (
    <div class="mb-3.5 flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-500" />
      <p class="text-sm font-bold text-ink-900 dark:text-slate-100">{title}</p>
    </div>
  )}
  <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((stat) => {
      const color = stat.color ?? 'brand';
      return (
        <div class="group relative flex flex-col items-center justify-center overflow-hidden rounded-xl border border-slate-200/90 bg-white p-4 text-center shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm dark:border-slate-700/80 dark:bg-slate-800/70">
          <span class={`absolute inset-x-0 top-0 h-0.5 ${topAccents[color]}`} />
          <p class={`text-2xl lg:text-3xl font-extrabold tracking-tight ${textColors[color]}`} dir="ltr">
            {stat.value}
          </p>
          <p class="mt-1 text-xs font-semibold text-ink-900 dark:text-slate-200">{stat.label}</p>
          {stat.note && <p class="mt-0.5 text-[10.5px] leading-relaxed text-ink-500 dark:text-slate-400">{stat.note}</p>}
        </div>
      );
    })}
  </div>
  {caption && <p class="mt-2 text-center text-xs text-ink-400 dark:text-slate-400">{caption}</p>}
</div>