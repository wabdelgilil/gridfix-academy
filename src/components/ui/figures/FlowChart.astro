---
interface FlowStep {
  title: string;
  detail?: string;
  icon?: string;
  type?: 'start' | 'step' | 'decision' | 'end';
}

interface Props {
  steps: FlowStep[];
  title?: string;
  caption?: string;
}

const { steps, title, caption } = Astro.props;

const styles: Record<string, string> = {
  start: 'border-brand-300 bg-brand-50 text-brand-800',
  end: 'border-ink-600 bg-ink-900 text-white',
  decision: 'border-amber-300 bg-amber-50 text-amber-800',
  step: 'border-slate-200 bg-white text-ink-800',
};
---

<div class="my-6">
  {title && <p class="mb-3 text-sm font-bold text-ink-900">{title}</p>}
  <ol class="relative space-y-0">
    {steps.map((step, i) => (
      <li class="relative flex gap-3">
        <div class="flex flex-col items-center">
          <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold ring-2 ring-offset-2 ${styles[step.type ?? 'step']}`}>
            {step.icon ?? i + 1}
          </span>
          {i < steps.length - 1 && <span class="my-1 w-0.5 flex-1 rounded bg-brand-200" />}
        </div>
        <div class={`mb-4 flex-1 rounded-xl border p-3 ${styles[step.type ?? 'step']}`} dir="auto">
          <p class="text-sm font-bold">{step.title}</p>
          {step.detail && <p class="mt-1 text-xs leading-relaxed opacity-80">{step.detail}</p>}
        </div>
      </li>
    ))}
  </ol>
  {caption && <p class="mt-1 text-center text-xs text-ink-400">{caption}</p>}
</div>