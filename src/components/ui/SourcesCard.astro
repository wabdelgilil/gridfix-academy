---
import { sources, type Source } from '../../data/sources';

interface Props {
  sourceIds: string[];
}
const { sourceIds } = Astro.props;

const items: Source[] = sourceIds
  .map((id) => sources[id])
  .filter((s): s is Source => Boolean(s));
---

<div class="card mt-8 overflow-hidden">
  <div class="border-b border-slate-200 bg-slate-50 px-5 py-3 text-sm font-semibold text-ink-900">
    📚 مصادر معتمدة للمراجعة
  </div>
  <div class="divide-y divide-slate-100">
    {items.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start justify-between gap-3 px-5 py-4 transition hover:bg-slate-50"
      >
        <div>
          <div class="flex items-center gap-2">
            <span dir="ltr" lang="en" class="text-sm font-semibold text-ink-900">{item.name}</span>
            <span class="chip bg-brand-100 text-brand-700">{item.kind}</span>
          </div>
          <p class="mt-1 text-sm leading-relaxed text-ink-600">{item.ar}</p>
        </div>
        <span class="mt-1 shrink-0 text-brand-600">↗</span>
      </a>
    ))}
  </div>
</div>