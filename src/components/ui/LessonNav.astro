---
import { getStation, type PlanLesson } from '../../data/curriculum';

interface Props {
  stationId: string;
  lessonId: string;
}
const { stationId, lessonId } = Astro.props;
const station = getStation(stationId);
const lessons = station?.lessons ?? [];
const currentIndex = lessons.findIndex((l) => l.id === lessonId);
const prev: PlanLesson | undefined = currentIndex > 0 ? lessons[currentIndex - 1] : undefined;
const next: PlanLesson | undefined = currentIndex >= 0 && currentIndex < lessons.length - 1 ? lessons[currentIndex + 1] : undefined;
const livePrev: PlanLesson | undefined = prev?.status === 'live' ? prev : undefined;
const liveNext: PlanLesson | undefined = next?.status === 'live' ? next : undefined;
---

<div class="mt-10 flex items-center justify-between gap-3 border-t border-slate-200 pt-6">
  <a
    href={livePrev ? `/lessons/${livePrev.id}` : undefined}
    class={`rounded-xl px-4 py-2 text-sm font-medium transition ${livePrev ? 'bg-white text-ink-900 ring-1 ring-slate-200 hover:bg-slate-50' : 'cursor-not-allowed text-ink-400 ring-1 ring-slate-100'}`}
    aria-disabled={!livePrev}
  >
    → {livePrev ? livePrev.number : '—'} {livePrev?.title ?? 'قريباً'}
  </a>
  <a href={`/stations/${stationId}`} class="rounded-xl bg-ink-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-ink-600">
    اكمال المحطة
  </a>
  <a
    href={liveNext ? `/lessons/${liveNext.id}` : undefined}
    class={`rounded-xl px-4 py-2 text-sm font-medium transition ${liveNext ? 'bg-white text-ink-900 ring-1 ring-slate-200 hover:bg-slate-50' : 'cursor-not-allowed text-ink-400 ring-1 ring-slate-100'}`}
    aria-disabled={!liveNext}
  >
    {liveNext ? liveNext.number : '—'} {liveNext?.title ?? 'قريباً'} ←
  </a>
</div>