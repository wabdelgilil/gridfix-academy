---
import { getStation, type PlanLesson } from '../../data/curriculum';
import LangText from './LangText.astro';

interface Props {
  course: string;
  stationId: string;
  lessonId: string;
}
const { course, stationId, lessonId } = Astro.props;
const station = getStation(stationId);
const lessons = station?.lessons ?? [];
const currentIndex = lessons.findIndex((l) => l.id === lessonId);
const prev: PlanLesson | undefined = currentIndex > 0 ? lessons[currentIndex - 1] : undefined;
const next: PlanLesson | undefined = currentIndex >= 0 && currentIndex < lessons.length - 1 ? lessons[currentIndex + 1] : undefined;
const livePrev: PlanLesson | undefined = prev?.status === 'live' ? prev : undefined;
const liveNext: PlanLesson | undefined = next?.status === 'live' ? next : undefined;
---

<div class="mt-10 border-t border-slate-200 pt-6">
  <div class="flex items-center justify-between gap-3">
    <a
      href={livePrev ? `/${course}/lessons/${livePrev.id}` : undefined}
      class={`flex items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium transition ${livePrev ? 'bg-white text-ink-900 ring-1 ring-slate-200 hover:bg-slate-50 hover:shadow-sm' : 'cursor-not-allowed text-ink-400 ring-1 ring-slate-100'}`}
      aria-disabled={!livePrev}
    >
      <span class="text-lg">→</span>
      <div class="text-right">
        <div class="text-xs text-ink-400">
          <LangText lang="ar">السابق</LangText>
          <LangText lang="en">Previous</LangText>
        </div>
        <div>
          <LangText lang="ar">{livePrev ? `${livePrev.number} ${livePrev.title}` : 'قريباً'}</LangText>
          <LangText lang="en">{livePrev ? `${livePrev.number} ${livePrev.titleEn}` : 'Coming soon'}</LangText>
        </div>
      </div>
    </a>
    <a href={`/${course}/stations/${stationId}`} class="flex items-center gap-2 rounded-xl bg-ink-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-ink-800 hover:shadow-md">
      <span>📋</span>
      <LangText lang="ar">إكمال المحطة</LangText>
      <LangText lang="en">Back to station</LangText>
    </a>
    <a
      href={liveNext ? `/${course}/lessons/${liveNext.id}` : undefined}
      class={`flex items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium transition ${liveNext ? 'bg-white text-ink-900 ring-1 ring-slate-200 hover:bg-slate-50 hover:shadow-sm' : 'cursor-not-allowed text-ink-400 ring-1 ring-slate-100'}`}
      aria-disabled={!liveNext}
    >
      <div class="text-left">
        <div class="text-xs text-ink-400">
          <LangText lang="ar">التالي</LangText>
          <LangText lang="en">Next</LangText>
        </div>
        <div>
          <LangText lang="ar">{liveNext ? `${liveNext.number} ${liveNext.title}` : 'قريباً'}</LangText>
          <LangText lang="en">{liveNext ? `${liveNext.number} ${liveNext.titleEn}` : 'Coming soon'}</LangText>
        </div>
      </div>
      <span class="text-lg">←</span>
    </a>
  </div>
</div>
