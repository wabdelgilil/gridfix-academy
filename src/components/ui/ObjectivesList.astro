---
interface Props {
  objectives: string[];
}
const { objectives } = Astro.props;
---

<div class="card mt-2 overflow-hidden">
  <div class="border-b border-slate-200 bg-brand-50 px-5 py-3 text-sm font-semibold text-brand-800">
    🎯 أهداف التعلم
  </div>
  <div class="grid gap-3 p-5 sm:grid-cols-2">
    {objectives.map((objective) => (
      <div class="flex items-start gap-2 text-sm leading-relaxed text-ink-600">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs text-brand-700">✓</span>
        <span>{objective}</span>
      </div>
    ))}
  </div>
</div>