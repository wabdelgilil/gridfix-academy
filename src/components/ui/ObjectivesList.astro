---
interface Props {
  objectives: string[];
  objectivesEn?: string[];
}
const { objectives } = Astro.props;
const objectivesEn = Astro.props.objectivesEn ?? [];
---

<div class="card mt-4 overflow-hidden">
  <div class="flex items-center gap-2 border-b border-slate-200 bg-gradient-to-l from-brand-50 to-brand-50/50 px-5 py-3">
    <span class="text-lg">🎯</span>
    <span class="text-sm font-semibold text-brand-800" data-lang="ar">أهداف التعلم</span>
    <span class="text-sm font-semibold text-brand-800" data-lang="en">Learning objectives</span>
    <span class="rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">{objectives.length} {''} <span data-lang="ar">أهداف</span><span data-lang="en">objectives</span></span>
  </div>

  <div class="grid gap-3 p-5 sm:grid-cols-2">
    {objectives.map((objective, index) => (
      <div class="flex items-start gap-3 text-sm leading-relaxed text-ink-600" data-lang="ar">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">{index + 1}</span>
        <span dir="rtl">{objective}</span>
      </div>
    ))}
    {objectivesEn.map((objective, index) => (
      <div class="flex items-start gap-3 text-sm leading-relaxed text-ink-600" data-lang="en">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">{index + 1}</span>
        <span dir="ltr">{objective}</span>
      </div>
    ))}
  </div>
</div>