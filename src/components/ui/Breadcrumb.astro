---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  homeLabel?: string;
}

const { items, homeLabel = 'GridFix Academy' } = Astro.props;
const crumbs: Crumb[] = [{ label: homeLabel, href: '/' }, ...items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, Astro.site ?? 'https://academy.gridfix.net').toString() } : {}),
  })),
};
---

<nav class="mb-6 text-sm text-ink-400" aria-label="Breadcrumb">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <ol class="flex flex-wrap items-center gap-2">
    {crumbs.map((c, i) => {
      const last = i === crumbs.length - 1;
      return (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">←</span>}
          {c.href && !last ? (
            <a href={c.href} class="transition hover:text-brand-700 hover:underline">{c.label}</a>
          ) : (
            <span class={last ? 'font-semibold text-ink-600' : ''}>{c.label}</span>
          )}
        </li>
      );
    })}
  </ol>
</nav>